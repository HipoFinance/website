---
import { getCollection, render } from 'astro:content'
import { localeOf, localizedPath } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import { formatNumber, formatPercent } from '../i18n/format.ts'

// HPO token page content. Recreates design/HPO.dc.html in the Warm Dark tokens defined in
// src/styles/global.css. Owned by src/pages/hpo/index.astro only. Every visible string comes from
// src/i18n/<locale>/hpo.json; sentences that wrap a live element or a link are built here and
// interpolated through tHtml so translators can move the pieces.
const locale = localeOf(Astro)
const { t, tHtml } = getT(locale, ['hpo'])

// The HPO allocation per docs/hipo-tokens/hipo-governance-token-hpo/tokenomics/ — percentages of
// the 1B minted, so they always sum to 100 regardless of burns. Rendered as an inline SVG donut
// (replacing the old static Google-Sheets export) so hpo-data.js can layer the live burned share
// on top: an ember arc inside the ring plus a count-up in the hole, revealed on scroll.
const tokenomics = [
  { label: t('hpo.tokenomics.community'), pct: 30, color: '#ff7e73' },
  { label: t('hpo.tokenomics.liquidity'), pct: 20, color: '#6fc7b2' },
  { label: t('hpo.tokenomics.team'), pct: 20, color: '#7ea6e0' },
  { label: t('hpo.tokenomics.marketing'), pct: 15, color: '#b795e0' },
  { label: t('hpo.tokenomics.treasury'), pct: 13, color: '#9ab87c' },
  { label: t('hpo.tokenomics.advisers'), pct: 2, color: '#8d7f76' },
].map((slice) => ({ ...slice, pctText: formatPercent(locale, slice.pct / 100, 0) }))
// Donut slice geometry via pathLength=100: each circle draws pct units minus a small gap,
// dashoffset walks the start point clockwise from 12 o'clock (25 = the top of an SVG circle).
const GAP = 1.2
let sliceStart = 0
const slices = tokenomics.map((t) => {
  const start = sliceStart
  sliceStart += t.pct
  return { ...t, dasharray: `${t.pct - GAP} ${100 - t.pct + GAP}`, dashoffset: 25 - start - GAP / 2 }
})
const chartLabel = t('hpo.tokenomics.chartLabel', {
  items: tokenomics
    .map((slice) => t('hpo.tokenomics.chartItem', { label: slice.label, pct: slice.pctText }))
    .join(t('hpo.tokenomics.chartSeparator')),
})

const buySteps = [1, 2, 3, 4].map((n) => ({
  num: t(`hpo.buy.step${n}.num`),
  text: t(`hpo.buy.step${n}.text`),
}))

const utility = [
  { icon: '/images/money.svg', key: 'profit' },
  { icon: '/images/hat.svg', key: 'earn' },
  { icon: '/images/percentage.svg', key: 'level' },
  { icon: '/images/governance.svg', key: 'vote' },
]

const scarcity = [
  { icon: '/images/diamond.svg', key: 'fixed' },
  { icon: '/images/lockup.svg', key: 'team' },
  { icon: '/images/star-shine.svg', key: 'seasonal' },
  { icon: '/images/heart-shine.svg', key: 'held' },
]

const tokenomicsDocs = localizedPath('/docs/hipo-tokens/hipo-governance-token-hpo/tokenomics/', locale)
const clubDocs = localizedPath('/docs/giveaways-and-prizes/hipo-club/', locale)
const link = (href: string, label: string, external = false) =>
  `<a href="${href}"${external ? ' target="_blank" rel="noopener noreferrer"' : ''} class="text-accent">${label}</a>`

// The FAQ answers come from the `prose` collection: src/content/prose/<locale>/hpo-faq/<nn>-<slug>.md.
const faqPrefix = `${locale}/hpo-faq/`
const hpoFaq = await Promise.all(
  (await getCollection('prose', (entry) => entry.id.startsWith(faqPrefix)))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
)
---

<script src='/src/scripts/hpo-data.js'></script>
<script src='/src/scripts/hpo-sparkline.ts'></script>

<main class='mx-auto w-full max-w-[1280px] px-6 sm:px-12'>
  <!-- Hero -->
  <section class='grid items-center gap-12 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12 lg:py-16'>
    <div class='flex flex-col items-start gap-[22px]'>
      <h1
        class='font-fredoka text-[40px] leading-[1.1] font-semibold sm:text-[54px]'
        set:html={tHtml('hpo.hero.title', { accent: '<span class="text-accent">HPO</span>' })}
      />
      <p class='text-text-muted max-w-[480px] text-[19px] leading-[1.6]'>{t('hpo.hero.lead')}</p>
      <div class='flex flex-wrap items-center gap-3.5'>
        <a
          href='https://app.ston.fi/swap?chartVisible=false&ft=TON&tt=HPO'
          target='_blank'
          rel='noopener noreferrer'
          class='bg-accent text-on-accent hover:bg-accent-hover rounded-full px-9 py-[15px] text-[17px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)]'
        >
          {t('hpo.hero.buy')}
        </a>
        <a href={tokenomicsDocs} class='hover:text-accent px-3 py-[15px] text-base font-medium'>
          {t('hpo.hero.tokenomicsDocs')}
        </a>
      </div>
    </div>

    <div class='border-border bg-surface flex flex-col gap-[18px] rounded-[24px] border p-7'>
      <div class='flex items-center gap-3'>
        <img src='/hpo.png' class='size-11' alt='HPO' />
        <div>
          <div class='font-fredoka text-lg font-semibold'>{t('hpo.hero.pair')}</div>
          <div class='text-text-muted text-[13px]'>{t('hpo.hero.liveData')}</div>
        </div>
        <span class='text-positive ms-auto flex items-center gap-1.5 text-[13px] font-medium'>
          <span class='bg-positive inline-block size-[7px] rounded-full'></span>
          {t('hpo.hero.live')}
        </span>
      </div>

      <!-- Filled by hpo-sparkline.ts from 30 days of the hipo_hpo_current_price Prometheus series
      (the same allowlisted combined query the Stats page charts use). The height is reserved by
      the viewBox/class regardless of data; no line or fill is drawn until real points arrive, and
      none is drawn on failure either — never a fake shape. -->
      <svg id='hpoSparkline' viewBox='0 0 400 120' class='h-[120px] w-full' preserveAspectRatio='none'></svg>

      <div class='flex justify-between gap-3'>
        <div>
          <div id='hpoMarketCap' class='font-fredoka text-[22px] font-semibold'>—</div>
          <div class='text-text-muted text-[13px]'>{t('hpo.hero.marketCap')}</div>
        </div>
        <div>
          <div id='hpoVolume' class='font-fredoka text-[22px] font-semibold'>—</div>
          <div class='text-text-muted text-[13px]'>{t('hpo.hero.volume')}</div>
        </div>
        <div>
          <div id='hpoHolders' class='font-fredoka text-[22px] font-semibold'>—</div>
          <div class='text-text-muted text-[13px]'>{t('hpo.hero.holders')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- HPO utility -->
  <section class='py-6'>
    <h2 class='font-fredoka mb-7 text-[40px] font-semibold'>{t('hpo.utility.title')}</h2>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {
        utility.map(({ icon, key }) => (
          <div class='border-border bg-surface flex flex-col gap-2.5 rounded-[20px] border p-6'>
            <img src={icon} class='size-11' alt='' />
            <div class='font-fredoka text-[19px] font-semibold'>{t(`hpo.utility.${key}.title`)}</div>
            <p class='text-text-muted text-[15px] leading-[1.55]'>{t(`hpo.utility.${key}.body`)}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- How to buy / Tokenomics -->
  <section id='tokenomics' class='py-12'>
    <div class='grid items-start gap-12 lg:grid-cols-2'>
      <div>
        <h2 class='font-fredoka mb-5 text-[40px] font-semibold'>{t('hpo.buy.title')}</h2>
        <div class='flex flex-col'>
          {
            buySteps.map((step, i) => (
              <div
                class={
                  i < buySteps.length - 1
                    ? 'border-border grid grid-cols-[56px_1fr] items-center gap-[18px] border-b py-[18px]'
                    : 'grid grid-cols-[56px_1fr] items-center gap-[18px] py-[18px]'
                }
              >
                <span class='bg-accent text-on-accent font-fredoka inline-flex size-11 items-center justify-center rounded-[14px] text-[19px] font-semibold'>
                  {step.num}
                </span>
                <span class='text-[16px] leading-[1.5]'>{step.text}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <h2 class='font-fredoka mb-5 text-[40px] font-semibold'>{t('hpo.tokenomics.title')}</h2>
        <div class='border-border bg-surface rounded-[20px] border p-6'>
          <div class='flex flex-col items-center gap-7 sm:flex-row'>
            <div id='hpoTokenomicsChart' class='relative w-full max-w-[250px] shrink-0'>
              <svg viewBox='0 0 240 240' role='img' aria-label={chartLabel}>
                {
                  slices.map((s) => (
                    <circle
                      cx='120'
                      cy='120'
                      r='88'
                      fill='none'
                      stroke={s.color}
                      stroke-width='33'
                      pathLength='100'
                      stroke-dasharray={s.dasharray}
                      stroke-dashoffset={s.dashoffset}
                    />
                  ))
                }
                <!-- The live burned share of the 1B minted, swept in by hpo-data.js once the
                on-chain figure arrives and the chart is scrolled into view. -->
                <circle
                  id='hpoBurnArc'
                  cx='120'
                  cy='120'
                  r='62'
                  fill='none'
                  stroke='#ffb03a'
                  stroke-width='7'
                  stroke-linecap='round'
                  pathLength='100'
                  stroke-dasharray='0 100'
                  stroke-dashoffset='25'></circle>
              </svg>
              <!-- Counted up from zero by hpo-data.js (on-chain jetton supply: 1B minted minus the
              current total). Stays an em dash if the lookup fails — never a hardcoded number. -->
              <div class='absolute inset-0 flex flex-col items-center justify-center gap-0.5 text-center'>
                <div class='font-fredoka text-[21px] font-semibold'>🔥 <span id='hpoBurned'>—</span></div>
                <div class='text-text-muted text-[13px]'>{t('hpo.tokenomics.burned')}</div>
              </div>
            </div>
            <ul class='w-full space-y-2.5 text-[15px]'>
              {
                slices.map((s) => (
                  <li class='flex items-center gap-2.5'>
                    <span class='inline-block size-3 shrink-0 rounded-full' style={`background:${s.color}`} />
                    <span>{s.label}</span>
                    <span class='text-text-muted ms-auto'>{s.pctText}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <p class='text-text-muted mt-5 text-[15px] leading-[1.55]'>
            {t('hpo.tokenomics.body')}
            <a href={tokenomicsDocs} class='text-accent'>{t('hpo.tokenomics.learnMore')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- A shrinking supply -->
  <section class='py-12'>
    <h2 class='font-fredoka mb-2 text-[40px] font-semibold'>{t('hpo.scarcity.title')}</h2>
    <p class='text-text-muted mb-7 text-[18px]'>{t('hpo.scarcity.subtitle')}</p>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {
        scarcity.map(({ icon, key }) => (
          <div class='border-border bg-surface flex flex-col gap-2.5 rounded-[20px] border p-6'>
            <img src={icon} class='size-11' alt='' />
            <div class='font-fredoka text-[19px] font-semibold'>{t(`hpo.scarcity.${key}.title`)}</div>
            <p class='text-text-muted text-[15px] leading-[1.55]'>{t(`hpo.scarcity.${key}.body`)}</p>
          </div>
        ))
      }
    </div>
    <p
      class='text-text-muted mt-5 text-[15px]'
      set:html={tHtml('hpo.scarcity.details', {
        tokenomicsLink: link(tokenomicsDocs, t('hpo.scarcity.tokenomicsDocs')),
        clubLink: link(clubDocs, t('hpo.scarcity.clubDocs')),
      })}
    />
  </section>

  <!-- Early investors -->
  <section class='py-12'>
    <h2 class='font-fredoka mb-2 text-[40px] font-semibold'>{t('hpo.investors.title')}</h2>
    <p class='text-text-muted mb-7 text-[18px]'>{t('hpo.investors.subtitle')}</p>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-3'>
      <div class='border-border bg-surface flex flex-col gap-3 rounded-[20px] border p-6'>
        <div class='font-fredoka text-accent text-[19px] font-semibold'>{t('hpo.investors.metrics.title')}</div>
        <div class='flex flex-col gap-2 text-[15px] leading-[1.5]'>
          <span
            set:html={tHtml('hpo.investors.metrics.tvl', {
              tvl: '<strong class="text-text font-bold"><span id="hpoTvlGram">—</span> GRAM</strong>',
              usd: '<span id="hpoTvlUsd">—</span>',
            })}
          />
          <span
            set:html={tHtml('hpo.investors.metrics.stakers', {
              stakers: '<strong id="hpoStakers" class="text-text font-bold">—</strong>',
              link: link(localizedPath('/stats/', locale), t('hpo.investors.metrics.liveStats')),
            })}
          />
        </div>
      </div>
      <div class='border-border bg-surface flex flex-col gap-3 rounded-[20px] border p-6'>
        <div class='font-fredoka text-accent text-[19px] font-semibold'>{t('hpo.investors.audited.title')}</div>
        <div class='flex flex-col gap-2 text-[15px] leading-[1.5]'>
          <span
            set:html={tHtml('hpo.investors.audited.audits', {
              count: `<strong class="text-text font-bold">${t('hpo.investors.audited.auditsCount')}</strong>`,
            })}
          />
          <span
            set:html={tHtml('hpo.investors.audited.openSource', {
              link: link('https://github.com/HipoFinance', 'GitHub', true),
            })}
          />
        </div>
      </div>
      <div class='border-border bg-surface flex flex-col gap-3 rounded-[20px] border p-6'>
        <div class='font-fredoka text-accent text-[19px] font-semibold'>{t('hpo.investors.growth.title')}</div>
        <div class='flex flex-col gap-2 text-[15px] leading-[1.5]'>
          <span>{t('hpo.investors.growth.early')}</span>
          <span>{t('hpo.investors.growth.fundraising')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Watch & learn -->
  <section class='py-12'>
    <h2 class='font-fredoka mb-7 text-[40px] font-semibold'>{t('hpo.watch.title')}</h2>
    <div class='grid grid-cols-1 gap-6 lg:grid-cols-2'>
      <div class='border-border bg-surface rounded-[20px] border p-4'>
        <iframe
          class='aspect-video w-full rounded-[12px]'
          src='https://www.youtube.com/embed/QYU-TWJK1yg'
          title={t('hpo.watch.videoTitle')}
          allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
          allowfullscreen></iframe>
      </div>
      <div class='border-border bg-surface rounded-[20px] border p-4'>
        <iframe
          class='aspect-video w-full rounded-[12px]'
          src='https://youtube.com/embed/ZHAlS4wystU?feature=share'
          title={t('hpo.watch.videoTitle')}
          allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class='py-12'>
    <h2 class='font-fredoka mb-7 text-[40px] font-semibold'>{t('hpo.faq.title')}</h2>
    <div class='flex flex-col gap-4'>
      {
        hpoFaq.map(({ entry, Content }, i) => (
          <details open={i === 0} class='border-border bg-surface scroll-mt-6 rounded-2xl border px-[22px] py-[18px]'>
            <summary class='text-text cursor-pointer text-[17px] font-medium'>
              {t('hpo.faq.item', { n: formatNumber(locale, entry.data.order), question: entry.data.question ?? '' })}
            </summary>
            <div class='hpo-answer text-text-muted flex flex-col gap-2.5 pt-3 text-[15px] leading-[1.6]'>
              <Content />
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA -->
  <section class='py-12 pb-[72px]'>
    <div
      class='border-border flex flex-col items-start justify-between gap-8 rounded-[28px] border p-8 sm:flex-row sm:items-center sm:p-12'
      style='background: linear-gradient(120deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%)'
    >
      <div class='flex max-w-[620px] flex-col gap-2.5'>
        <h2 class='font-fredoka text-[32px] font-semibold'>{t('hpo.cta.title')}</h2>
        <p class='text-text-muted text-[16px] leading-[1.6]'>{t('hpo.cta.body')}</p>
      </div>
      <a
        href='https://app.ston.fi/swap?chartVisible=false&ft=TON&tt=HPO'
        target='_blank'
        rel='noopener noreferrer'
        class='bg-accent text-on-accent hover:bg-accent-hover shrink-0 rounded-full px-[30px] py-[14px] text-[16px] font-semibold'
      >
        {t('hpo.cta.buy')}
      </a>
    </div>
  </section>
</main>

<style>
  /* The FAQ answers are rendered Markdown; these reproduce the utilities the handwritten markup
     carried: lower-alpha inside lists with gap-2.5, text-text font-bold emphasis, text-accent links. */
  .hpo-answer :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style-position: inside;
    list-style-type: lower-alpha;
  }
  .hpo-answer :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }
  .hpo-answer :global(a) {
    color: var(--color-accent);
  }

  /* The tokenomics burn arc: hpo-data.js only sets stroke-dasharray, this transition turns that
     into the attention-grabbing sweep. The ember glow separates it from the allocation ring. */
  #hpoBurnArc {
    filter: drop-shadow(0 0 5px rgba(255, 176, 58, 0.55));
    transition: stroke-dasharray 1.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    #hpoBurnArc {
      transition: none;
    }
  }
</style>
