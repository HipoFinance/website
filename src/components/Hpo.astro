---
import { getCollection, render } from 'astro:content'
import { localeOf, localizedPath } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import { formatNumber, formatPercent, formatSignedPercent } from '../i18n/format.ts'
import { hpoFaqAnchor } from './hpoFaq.ts'
import AnchorLink from './AnchorLink.astro'
import { fetchStatsSeed } from '../data/stats.ts'
import { fetchGauge, gaugeValues, hpoSupply, HPO_MINTED, HPO_SECTION_KEYS } from '../data/gauge.ts'

// HPO token page content. Recreates design/HPO.dc.html in the Warm Dark tokens defined in
// src/styles/global.css. Owned by src/pages/hpo/index.astro only. Every visible string comes from
// src/i18n/<locale>/hpo.json; sentences that wrap a live element or a link are built here and
// interpolated through tHtml so translators can move the pieces.
const locale = localeOf(Astro)
// The `app` catalog too: the price chart reuses the Stats page's range pills and chart messages.
const { t, tHtml } = getT(locale, ['hpo', 'app'])
// The hero sparkline plots the gauge's HPO price. Since 2026-10-17 the gauge derives it from the
// STON.fi v2 and DeDust HPO/hGRAM pools on chain (reserves × the treasury rate × GRAM's price), not
// from CoinGecko, whose figure was dragged down by a mis-read pool; the CoinGecko link under the
// card stays as the outside reference a reader will want to compare with.
const coinGeckoHpo = 'https://www.coingecko.com/en/coins/hipo-governance-token'

// Live market and protocol numbers, baked in at build time and refreshed in the browser by
// src/scripts/hpo-data.js through the same gaugeValues(); each falls back to the em dash the page
// used to always ship.
const gaugeData = await fetchGauge()
const gauge = gaugeValues(locale, gaugeData)
// The tokenomics card's supply bar (specs/hpo-tokenomics-supply-bar.md): burned, circulating and
// held by Hipo, as shares of the 1B minted. Baked like the rest; hpo-data.js blanks the burned
// count before the card is seen and counts it up when it scrolls into view.
const supply = hpoSupply(locale, gaugeData)
// The hero card's figures; the ids are what hpo-data.js refreshes.
const figures = [
  { id: 'hpoMarketCap', value: gauge.hpoMarketCap, label: 'hpo.hero.marketCap' },
  { id: 'hpoCirculating', value: gauge.hpoCirculating, label: 'hpo.hero.circulating' },
  { id: 'hpoHolders', value: gauge.hpoHolders, label: 'hpo.hero.holders' },
]
// The chart's range pills, the Stats page's five (specs/hpo-chart-ranges-and-hover.md); the month
// is selected at first, as there. hpo-sparkline.ts fetches on a click and moves aria-pressed.
const ranges: { key: string; label: string }[] = [
  { key: '24h', label: t('app.chart.range24h') },
  { key: '7d', label: t('app.chart.range1w') },
  { key: '30d', label: t('app.chart.range1m') },
  { key: '90d', label: t('app.chart.range3m') },
  { key: '1y', label: t('app.chart.range1y') },
]
const defaultRange = '30d'
// The change beside the price, baked for the chart's opening range from the build-time Prometheus seed
// the Stats page uses (src/data/stats.ts), so the first paint already names the range the chart shows.
// hpo-sparkline.ts recomputes it from the live history and on every range switch.
const seed = await fetchStatsSeed()
const changeDelta = seed?.range === defaultRange ? seed.deltas.hpo : undefined
const changeText = changeDelta === undefined ? undefined : formatSignedPercent(locale, changeDelta.value / 100)
const changeLabel = ranges.find((r) => r.key === defaultRange)?.label

// The HPO allocation per docs/hipo-tokens/hipo-governance-token-hpo/ — percentages of
// the 1B minted, so they always sum to 100 regardless of burns. Rendered as an inline SVG donut
// (replacing the old static Google-Sheets export); where those 1B are today is the supply bar
// under it, since a 2% burn is a dot on a ring but a labelled figure beside a bar.
const tokenomics = [
  { label: t('hpo.tokenomics.community'), pct: 30, color: 'var(--color-alloc-community)' },
  { label: t('hpo.tokenomics.liquidity'), pct: 20, color: 'var(--color-alloc-liquidity)' },
  { label: t('hpo.tokenomics.team'), pct: 20, color: 'var(--color-alloc-team)' },
  { label: t('hpo.tokenomics.marketing'), pct: 15, color: 'var(--color-alloc-marketing)' },
  { label: t('hpo.tokenomics.treasury'), pct: 13, color: 'var(--color-alloc-treasury)' },
  { label: t('hpo.tokenomics.advisers'), pct: 2, color: 'var(--color-alloc-advisers)' },
].map((slice) => ({ ...slice, pctText: formatPercent(locale, slice.pct / 100, 0) }))
// Donut slice geometry via pathLength=100: each circle draws pct units minus a small gap,
// dashoffset walks the start point clockwise from 12 o'clock (25 = the top of an SVG circle).
const GAP = 1.2
let sliceStart = 0
const slices = tokenomics.map((t) => {
  const start = sliceStart
  sliceStart += t.pct
  return { ...t, dasharray: `${t.pct - GAP} ${100 - t.pct + GAP}`, dashoffset: 25 - start - GAP / 2 }
})
const chartLabel = t('hpo.tokenomics.chartLabel', {
  items: tokenomics
    .map((slice) => t('hpo.tokenomics.chartItem', { label: slice.label, pct: slice.pctText }))
    .join(t('hpo.tokenomics.chartSeparator')),
})
// The supply bar's three figures: ids are what hpo-data.js refreshes (the figure, its percentage
// and its bar segment share one stem). The burned count is exact, the other two compact.
const DASH = '—'
const supplyFigures = [
  {
    id: 'hpoBurned',
    value: supply?.burned,
    pct: supply?.burnedPct,
    share: supply?.burnedShare,
    label: 'hpo.tokenomics.burned',
    note: 'hpo.tokenomics.burnedNote',
    swatch: 'bg-ember shadow-[0_0_6px_var(--color-ember-glow)]',
    flame: true,
  },
  {
    id: 'hpoSupplyCirculating',
    value: supply?.circulating,
    pct: supply?.circulatingPct,
    share: supply?.circulatingShare,
    label: 'hpo.tokenomics.circulating',
    note: 'hpo.tokenomics.circulatingNote',
    swatch: 'bg-hpo',
    flame: false,
  },
  {
    id: 'hpoSupplyHeld',
    value: supply?.held,
    pct: supply?.heldPct,
    share: supply?.heldShare,
    label: 'hpo.tokenomics.held',
    note: 'hpo.tokenomics.heldNote',
    swatch: 'bg-border-strong',
    flame: false,
  },
]
// The held total split by wallet (sections is undefined until the gauge sends it). Every known
// section is rendered, hidden when absent, and the single held segment is rendered at width 0 beside
// them, so hpo-data.js can switch between the two at a refresh without a reload.
const HELD_GREY = 'var(--color-border-strong)'
const sectionKeys = [...HPO_SECTION_KEYS, 'other']
const cap = (key: string) => key.charAt(0).toUpperCase() + key.slice(1)
const sectionRows = sectionKeys.map((key) => {
  const section = supply?.sections?.find((s) => s.key === key)
  return {
    key,
    id: `hpoHeld${cap(key)}`,
    color: key === 'other' ? HELD_GREY : `var(--color-alloc-${key})`,
    label: t(key === 'other' ? 'hpo.tokenomics.heldOther' : `hpo.tokenomics.${key}`),
    section,
  }
})
const sectionItems =
  supply?.sections === undefined
    ? ''
    : sectionRows
        .filter((row) => row.section !== undefined)
        .map((row) =>
          t('hpo.tokenomics.sectionItem', { label: row.label, amount: row.section!.amount, pct: row.section!.pct }),
        )
        .join(t('hpo.tokenomics.chartSeparator'))
const mintedText = formatNumber(locale, HPO_MINTED)
const supplyLabel = t(
  supply?.sections === undefined ? 'hpo.tokenomics.supplyLabel' : 'hpo.tokenomics.supplyLabelSections',
  {
    minted: mintedText,
    burned: supply?.burned ?? DASH,
    circulating: supply?.circulating ?? DASH,
    held: supply?.held ?? DASH,
    sections: sectionItems,
  },
)

const buySteps = [1, 2, 3, 4].map((n) => ({
  num: t(`hpo.buy.step${n}.num`),
  text: t(`hpo.buy.step${n}.text`),
}))

const utility = [
  { icon: '/images/money.svg', key: 'profit' },
  { icon: '/images/hat.svg', key: 'earn' },
  { icon: '/images/percentage.svg', key: 'level' },
  { icon: '/images/governance.svg', key: 'vote' },
]

const scarcity = [
  { icon: '/images/diamond.svg', key: 'fixed' },
  { icon: '/images/lockup.svg', key: 'team' },
  { icon: '/images/star-shine.svg', key: 'seasonal' },
  { icon: '/images/heart-shine.svg', key: 'held' },
]

const tokenomicsDocs = localizedPath('/docs/hipo-tokens/hipo-governance-token-hpo/', locale)
const clubDocs = localizedPath('/docs/giveaways-and-prizes/hipo-club/', locale)
const supplyDocs = localizedPath('/docs/hipo-tokens/hipo-governance-token-hpo/hpo-tokens-distribution/', locale)
const link = (href: string, label: string, external = false) =>
  `<a href="${href}"${external ? ' target="_blank" rel="noopener noreferrer"' : ''} class="text-accent">${label}</a>`

// The FAQ answers come from the `prose` collection: src/content/prose/<locale>/hpo-faq/<nn>-<slug>.md;
// each one gets the anchor hpoFaqAnchor() derives, so questions are deep-linkable like /faq/.
const faqPrefix = `${locale}/hpo-faq/`
const hpoFaq = await Promise.all(
  (await getCollection('prose', (entry) => entry.id.startsWith(faqPrefix)))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ entry, anchor: hpoFaqAnchor(entry.id), Content: (await render(entry)).Content })),
)
---

<script src='/src/scripts/hpo-anchors.ts'></script>
<script src='/src/scripts/hpo-data.js'></script>
<script src='/src/scripts/hpo-sparkline.ts'></script>

<main class='mx-auto w-full max-w-[1280px] px-6 sm:px-12'>
  <!-- Hero -->
  <!-- grid-cols-1, not the implicit `auto` column: an auto track never shrinks below the headline's longest
       word, which widened the page on phones in the longer locales (specs/mobile-fit-hpo-hero-and-stake-toggle.md). -->
  <section class='grid grid-cols-1 items-center gap-12 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12 lg:py-16'>
    <div class='flex flex-col items-start gap-[22px]'>
      <h1
        class='font-fredoka text-[40px] leading-[1.1] font-semibold hyphens-auto sm:text-[54px]'
        set:html={tHtml('hpo.hero.title', { accent: '<span class="text-accent">HPO</span>' })}
      />
      <p class='text-text-muted max-w-[480px] text-[19px] leading-[1.6]'>{t('hpo.hero.lead')}</p>
      <div class='flex flex-wrap items-center gap-3.5'>
        <a
          href='https://app.ston.fi/swap?chartVisible=false&ft=TON&tt=HPO'
          target='_blank'
          rel='noopener noreferrer'
          class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover rounded-full px-9 py-[15px] text-[17px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)]'
        >
          {t('hpo.hero.buy')}
        </a>
        <a href={tokenomicsDocs} class='hover:text-accent px-3 py-[15px] text-base font-medium'>
          {t('hpo.hero.tokenomicsDocs')}
        </a>
      </div>
    </div>

    <div class='flex flex-col gap-2.5'>
      <div class='border-border bg-surface flex flex-col gap-[18px] rounded-[24px] border p-7'>
        <!-- Header and price row share a tighter gap than the card's 18px, so the price reads as part of
        the header; the graph below is pulled up to sit 10px under it. -->
        <div class='flex flex-col gap-2'>
          <div class='flex items-center gap-3'>
            <img src='/hpo.png' class='size-11' alt='HPO' />
            <div>
              <div class='font-fredoka text-lg font-semibold'>{t('hpo.hero.pair')}</div>
              <div class='text-text-muted text-[13px]'>{t('hpo.hero.liveData')}</div>
            </div>
            <span class='text-positive ms-auto flex items-center gap-1.5 text-[13px] font-medium'>
              <span class='bg-positive inline-block size-[7px] rounded-full'></span>
              {t('hpo.hero.live')}
            </span>
          </div>

          <!-- The latest price, derived by the gauge from the on-chain pools; baked here and refreshed by
          hpo-data.js. The change beside it is over the chart's range: baked for the opening range (1M) from
          the build-time seed, hidden when the build could not fetch it, and recomputed by hpo-sparkline.ts
          once the history loads and on each range switch. -->
          <div class='flex flex-wrap items-baseline gap-x-3 gap-y-1'>
            <div
              id='hpoPrice'
              class='font-fredoka num text-[24px] leading-tight font-semibold'
              set:text={gauge.hpoPrice ?? '—'}
            />
            <!-- The 24h change and the chart's hovered time share one grid cell: while a point of the chart
            is picked, hpo-sparkline.ts puts that point's price in #hpoPrice and its time here, and makes the
            change invisible rather than gone, so the row never reflows mid-scrub. -->
            <span class='grid'>
              <div
                id='hpoChangeWrap'
                class='col-start-1 row-start-1 flex items-baseline gap-1.5'
                hidden={changeText === undefined}
              >
                <span
                  id='hpoChange'
                  class:list={[
                    'num text-[14px] font-medium',
                    changeDelta?.direction === 'down' ? 'text-accent' : 'text-positive',
                  ]}
                  set:text={changeText ?? ''}
                />
                <span id='hpoChangeLabel' class='text-text-muted text-[13px]'>{changeLabel}</span>
              </div>
              <span id='hpoHoverTime' class='num text-text-muted invisible col-start-1 row-start-1 text-[13px]'></span>
            </span>
          </div>
        </div>

        <!-- The price chart (specs/hpo-chart-ranges-and-hover.md): hpo-sparkline.ts fetches the
        hipo_hpo_current_price series for the chosen range through the same allowlisted query the Stats
        page charts use, sizes the viewBox to the card, and draws the line, the hover marks and the
        readout. The class reserves the height; no line or fill is drawn until real points arrive, and on
        failure the Stats page's error line shows here instead — never a fake shape. The strings the
        script needs ride as data attributes. dir=ltr: SVG coordinates are physical, as on /stats/. -->
        <div dir='ltr' class='relative -mt-2'>
          <svg
            id='hpoSparkline'
            class='focus-visible:outline-accent h-[120px] w-full touch-pan-y rounded-[12px] select-none focus-visible:outline-2 focus-visible:outline-offset-4'
            tabindex='0'
            role='img'
            aria-label={t('app.chart.ariaNoData', { title: t('hpo.hero.pair'), range: t('app.chart.range1m') })}
            data-title={t('hpo.hero.pair')}
            data-aria={t('app.chart.ariaSummary')}
            data-aria-empty={t('app.chart.ariaNoData')}
            data-error={t('app.chart.loadError')}
            data-empty={t('app.chart.noData')}></svg>
          <p
            id='hpoSparklineNote'
            class='text-text-muted absolute inset-0 flex items-center justify-center text-sm'
            hidden
          >
          </p>
        </div>
        <div
          id='hpoRange'
          role='group'
          aria-label={t('app.chart.rangeGroup')}
          class='bg-surface-deep -mt-1 inline-flex flex-row gap-0.5 self-start rounded-full p-0.5 text-[12px] font-semibold'
        >
          {
            ranges.map((r) => (
              <button
                type='button'
                data-range={r.key}
                aria-pressed={r.key === defaultRange}
                class='num text-text-muted aria-pressed:bg-accent-fill aria-pressed:text-on-accent not-aria-pressed:hover:text-accent cursor-pointer rounded-full px-3 py-1'
              >
                {r.label}
              </button>
            ))
          }
        </div>

        <!-- Below sm the three figures stack as a list: label at the start, value at the end, and the
        value takes a line of its own when the two don't fit. Most locales' figures and labels don't fit
        three abreast in a phone-width card, and squeezing them made the site-wide overflow-wrap split
        words. From sm up it is the three-column row, value over label. -->
        <div class='flex flex-col sm:flex-row sm:justify-between sm:gap-3'>
          {
            figures.map(({ id, value, label }) => (
              <div class='border-border flex min-w-0 flex-wrap items-baseline justify-between gap-x-3 border-t py-2.5 first:border-t-0 first:pt-0 last:pb-0 sm:block sm:border-t-0 sm:py-0'>
                <div
                  id={id}
                  class='font-fredoka order-2 ms-auto shrink-0 text-[22px] font-semibold whitespace-nowrap sm:whitespace-normal'
                  set:text={value ?? '—'}
                />
                <div class='text-text-muted order-1 min-w-0 text-[13px]'>{t(label)}</div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- How the figures are computed, in one sentence under the card (Behrang asked for it on the
      page itself, not only in the docs), with the docs section that spells out the arithmetic; then the
      CoinGecko chart as the outside reference, on a line of its own since the first sentence ends in a link. -->
      <div class='text-text-faint flex flex-col gap-1 px-3 text-[12px] leading-relaxed'>
        <p set:html={tHtml('hpo.hero.priced', { link: link(supplyDocs, t('hpo.hero.pricedLink')) })} />
        <p set:html={tHtml('hpo.hero.compare', { link: link(coinGeckoHpo, t('hpo.hero.compareLink'), true) })} />
      </div>
    </div>
  </section>

  <!-- HPO utility -->
  <section id='utility' class='py-6'>
    <h2 class='anchor-host font-fredoka mb-7 text-[40px] font-semibold'>
      {t('hpo.utility.title')}<AnchorLink anchor='utility' />
    </h2>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {
        utility.map(({ icon, key }) => (
          <div class='border-border bg-surface flex flex-col gap-2.5 rounded-[20px] border p-6'>
            <img src={icon} class='size-11' alt='' />
            <div class='font-fredoka text-[19px] font-semibold'>{t(`hpo.utility.${key}.title`)}</div>
            <p class='text-text-muted text-[15px] leading-[1.55]'>{t(`hpo.utility.${key}.body`)}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- How to buy / Tokenomics -->
  <section id='tokenomics' class='py-12'>
    <div class='grid items-start gap-12 lg:grid-cols-2'>
      <div>
        <h2 class='font-fredoka mb-5 text-[40px] font-semibold'>{t('hpo.buy.title')}</h2>
        <div class='flex flex-col'>
          {
            buySteps.map((step, i) => (
              <div
                class={
                  i < buySteps.length - 1
                    ? 'border-border grid grid-cols-[56px_1fr] items-center gap-[18px] border-b py-[18px]'
                    : 'grid grid-cols-[56px_1fr] items-center gap-[18px] py-[18px]'
                }
              >
                <span class='bg-accent-fill text-on-accent font-fredoka inline-flex size-11 items-center justify-center rounded-[14px] text-[19px] font-semibold'>
                  {step.num}
                </span>
                <span class='text-[16px] leading-[1.5]'>{step.text}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <h2 class='anchor-host font-fredoka mb-5 text-[40px] font-semibold'>
          {t('hpo.tokenomics.title')}<AnchorLink anchor='tokenomics' />
        </h2>
        <div class='border-border bg-surface rounded-[20px] border p-6'>
          <div class='flex flex-col items-center gap-7 sm:flex-row'>
            <div id='hpoTokenomicsChart' class='relative w-full max-w-[250px] shrink-0'>
              <svg viewBox='0 0 240 240' role='img' aria-label={chartLabel}>
                {
                  slices.map((s) => (
                    <circle
                      cx='120'
                      cy='120'
                      r='88'
                      fill='none'
                      stroke={s.color}
                      stroke-width='33'
                      pathLength='100'
                      stroke-dasharray={s.dasharray}
                      stroke-dashoffset={s.dashoffset}
                    />
                  ))
                }
              </svg>
              <div class='absolute inset-0 flex flex-col items-center justify-center gap-0.5 text-center'>
                <div class='font-fredoka text-[21px] font-semibold'>{formatNumber(locale, HPO_MINTED)}</div>
                <div class='text-text-muted text-[13px]'>{t('hpo.tokenomics.minted')}</div>
              </div>
            </div>
            <ul class='w-full space-y-2.5 text-[15px]'>
              {
                slices.map((s) => (
                  <li class='flex items-center gap-2.5'>
                    <span class='inline-block size-3 shrink-0 rounded-full' style={`background:${s.color}`} />
                    <span>{s.label}</span>
                    <span class='text-text-muted ms-auto'>{s.pctText}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- Where the 1B are today. The bar's three segments are the shares of the minted supply,
          baked from the gauge and refreshed by hpo-data.js with the figures; with no gauge data the
          track is empty and the figures are em dashes. A flex row, so it mirrors under RTL. -->
          <h3 class='font-fredoka mt-7 mb-3 text-[17px] font-semibold'>{t('hpo.tokenomics.supplyTitle')}</h3>
          <div
            id='hpoSupplyBar'
            class='bg-border flex h-3.5 gap-0.5 overflow-hidden rounded-full'
            role='img'
            aria-label={supplyLabel}
            data-minted={mintedText}
            data-template={t('hpo.tokenomics.supplyLabel')}
            data-template-sections={t('hpo.tokenomics.supplyLabelSections')}
            data-section-item={t('hpo.tokenomics.sectionItem')}
            data-separator={t('hpo.tokenomics.chartSeparator')}
            data-labels={JSON.stringify(Object.fromEntries(sectionRows.map((row) => [row.key, row.label])))}
          >
            {
              supplyFigures.map((f) => (
                <span
                  id={`${f.id}Bar`}
                  class={`h-full transition-[width] duration-[1.4s] motion-reduce:transition-none ${f.swatch}`}
                  style={`width:${f.share ?? 0}%`}
                  hidden={f.id === 'hpoSupplyHeld' && supply?.sections !== undefined}
                />
              ))
            }
            {
              sectionRows.map((row) => (
                <span
                  id={`${row.id}Bar`}
                  class='hatch h-full transition-[width] duration-[1.4s] motion-reduce:transition-none'
                  style={`--hatch-color:${row.color};width:${row.section?.share ?? 0}%`}
                  hidden={row.section === undefined}
                />
              ))
            }
          </div>
          <div class='mt-4 grid gap-3 sm:grid-cols-3'>
            {
              supplyFigures.map((f) => (
                <div>
                  <div class='font-fredoka flex items-center gap-2 text-[19px] font-semibold'>
                    <span
                      id={f.id === 'hpoSupplyHeld' ? 'hpoSupplyHeldSwatch' : undefined}
                      class={`inline-block size-2.5 shrink-0 rounded-[3px] ${f.id === 'hpoSupplyHeld' && supply?.sections !== undefined ? 'hatch' : f.swatch}`}
                      style={
                        f.id === 'hpoSupplyHeld' && supply?.sections !== undefined
                          ? `--hatch-color:${HELD_GREY}`
                          : undefined
                      }
                    />
                    <span>
                      {f.flame && '🔥 '}
                      <span id={f.id} data-burned={f.flame ? supply?.burnedExact : undefined}>
                        {f.value ?? DASH}
                      </span>
                    </span>
                  </div>
                  <div class='text-text-muted text-[13px]'>{t(f.label)}</div>
                  <div class='text-text-faint text-[12px]'>
                    <span id={`${f.id}Pct`}>{f.pct ?? DASH}</span> · {t(f.note)}
                  </div>
                </div>
              ))
            }
          </div>
          <ul
            id='hpoHeldSections'
            class='mt-4 grid gap-x-6 gap-y-2 text-[13px] sm:grid-cols-2'
            hidden={supply?.sections === undefined}
          >
            {
              sectionRows.map((row) => (
                <li class='flex items-center gap-2' hidden={row.section === undefined}>
                  <span
                    class='hatch inline-block size-2.5 shrink-0 rounded-[3px]'
                    style={`--hatch-color:${row.color}`}
                  />
                  <span class='min-w-0'>{row.label}</span>
                  <span class='num text-text-muted ms-auto whitespace-nowrap'>
                    <span id={row.id}>{row.section?.amount ?? DASH}</span> ·{' '}
                    <span id={`${row.id}Pct`}>{row.section?.pct ?? DASH}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <!-- The fully diluted value, price × total supply, beside the market cap it is so much larger than
          (CoinGecko shows the FDV; a reader coming from there sees $4M, then $193K here). Baked with the
          rest; hpo-data.js re-interpolates the template in data-template on each refresh. -->
          <p
            id='hpoFdv'
            class='text-text-muted mt-4 text-[13px]'
            data-template={t('hpo.tokenomics.fdv')}
            hidden={supply?.fdv === undefined}
          >
            {
              supply?.fdv === undefined
                ? ''
                : t('hpo.tokenomics.fdv', { total: supply.total, fdv: supply.fdv, circulating: supply.circulating })
            }
          </p>
          <p class='text-text-muted mt-5 text-[15px] leading-[1.55]'>
            {t('hpo.tokenomics.live')}
            {t('hpo.tokenomics.body')}
            <a href={tokenomicsDocs} class='text-accent'>{t('hpo.tokenomics.learnMore')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- A shrinking supply -->
  <section id='scarcity' class='py-12'>
    <h2 class='anchor-host font-fredoka mb-2 text-[40px] font-semibold'>
      {t('hpo.scarcity.title')}<AnchorLink anchor='scarcity' />
    </h2>
    <p class='text-text-muted mb-7 text-[18px]'>{t('hpo.scarcity.subtitle')}</p>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {
        scarcity.map(({ icon, key }) => (
          <div class='border-border bg-surface flex flex-col gap-2.5 rounded-[20px] border p-6'>
            <img src={icon} class='size-11' alt='' />
            <div class='font-fredoka text-[19px] font-semibold'>{t(`hpo.scarcity.${key}.title`)}</div>
            <p class='text-text-muted text-[15px] leading-[1.55]'>{t(`hpo.scarcity.${key}.body`)}</p>
          </div>
        ))
      }
    </div>
    <p
      class='text-text-muted mt-5 text-[15px]'
      set:html={tHtml('hpo.scarcity.details', {
        tokenomicsLink: link(tokenomicsDocs, t('hpo.scarcity.tokenomicsDocs')),
        clubLink: link(clubDocs, t('hpo.scarcity.clubDocs')),
      })}
    />
  </section>

  <!-- Early investors -->
  <section id='investors' class='py-12'>
    <h2 class='anchor-host font-fredoka mb-2 text-[40px] font-semibold'>
      {t('hpo.investors.title')}<AnchorLink anchor='investors' />
    </h2>
    <p class='text-text-muted mb-7 text-[18px]'>{t('hpo.investors.subtitle')}</p>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-3'>
      <div class='border-border bg-surface flex flex-col gap-3 rounded-[20px] border p-6'>
        <div class='font-fredoka text-accent text-[19px] font-semibold'>{t('hpo.investors.metrics.title')}</div>
        <div class='flex flex-col gap-2 text-[15px] leading-[1.5]'>
          <span
            set:html={tHtml('hpo.investors.metrics.tvl', {
              tvl: `<strong class="text-text font-bold"><span id="hpoTvlGram">${gauge.hpoTvlGram ?? '—'}</span> GRAM</strong>`,
              usd: `<span id="hpoTvlUsd">${gauge.hpoTvlUsd ?? '—'}</span>`,
            })}
          />
          <span
            set:html={tHtml('hpo.investors.metrics.stakers', {
              stakers: `<strong id="hpoStakers" class="text-text font-bold">${gauge.hpoStakers ?? '—'}</strong>`,
              link: link(localizedPath('/stats/', locale), t('hpo.investors.metrics.liveStats')),
            })}
          />
        </div>
      </div>
      <div class='border-border bg-surface flex flex-col gap-3 rounded-[20px] border p-6'>
        <div class='font-fredoka text-accent text-[19px] font-semibold'>{t('hpo.investors.audited.title')}</div>
        <div class='flex flex-col gap-2 text-[15px] leading-[1.5]'>
          <span
            set:html={tHtml('hpo.investors.audited.audits', {
              count: `<strong class="text-text font-bold">${t('hpo.investors.audited.auditsCount')}</strong>`,
            })}
          />
          <span
            set:html={tHtml('hpo.investors.audited.openSource', {
              link: link('https://github.com/HipoFinance', 'GitHub', true),
            })}
          />
        </div>
      </div>
      <div class='border-border bg-surface flex flex-col gap-3 rounded-[20px] border p-6'>
        <div class='font-fredoka text-accent text-[19px] font-semibold'>{t('hpo.investors.growth.title')}</div>
        <div class='flex flex-col gap-2 text-[15px] leading-[1.5]'>
          <span>{t('hpo.investors.growth.early')}</span>
          <span>{t('hpo.investors.growth.fundraising')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Watch & learn -->
  <section id='watch' class='py-12'>
    <h2 class='anchor-host font-fredoka mb-7 text-[40px] font-semibold'>
      {t('hpo.watch.title')}<AnchorLink anchor='watch' />
    </h2>
    <div class='grid grid-cols-1 gap-6 lg:grid-cols-2'>
      <div class='border-border bg-surface rounded-[20px] border p-4'>
        <iframe
          class='aspect-video w-full rounded-[12px]'
          src='https://www.youtube.com/embed/QYU-TWJK1yg'
          title={t('hpo.watch.videoTitle')}
          allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
          allowfullscreen></iframe>
      </div>
      <div class='border-border bg-surface rounded-[20px] border p-4'>
        <iframe
          class='aspect-video w-full rounded-[12px]'
          src='https://youtube.com/embed/ZHAlS4wystU?feature=share'
          title={t('hpo.watch.videoTitle')}
          allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id='faq' class='py-12'>
    <h2 class='anchor-host font-fredoka mb-7 text-[40px] font-semibold'>
      {t('hpo.faq.title')}<AnchorLink anchor='faq' />
    </h2>
    <div class='flex flex-col gap-4'>
      {
        hpoFaq.map(({ entry, anchor, Content }, i) => (
          <details
            id={anchor}
            open={i === 0}
            class='border-border bg-surface scroll-mt-6 rounded-2xl border px-[22px] py-[18px]'
          >
            <summary class='anchor-host text-text cursor-pointer text-[17px] font-medium'>
              {t('hpo.faq.item', { n: formatNumber(locale, entry.data.order), question: entry.data.question ?? '' })}
              <AnchorLink anchor={anchor} />
            </summary>
            <div class='hpo-answer text-text-muted flex flex-col gap-2.5 pt-3 text-[15px] leading-[1.6]'>
              <Content />
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA -->
  <section class='py-12 pb-[72px]'>
    <div
      class='border-border flex flex-col items-start justify-between gap-8 rounded-[28px] border p-8 sm:flex-row sm:items-center sm:p-12'
      style='background: linear-gradient(120deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%)'
    >
      <div class='flex max-w-[620px] flex-col gap-2.5'>
        <h2 class='font-fredoka text-[32px] font-semibold'>{t('hpo.cta.title')}</h2>
        <p class='text-text-muted text-[16px] leading-[1.6]'>{t('hpo.cta.body')}</p>
      </div>
      <a
        href='https://app.ston.fi/swap?chartVisible=false&ft=TON&tt=HPO'
        target='_blank'
        rel='noopener noreferrer'
        class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover shrink-0 rounded-full px-[30px] py-[14px] text-[16px] font-semibold'
      >
        {t('hpo.cta.buy')}
      </a>
    </div>
  </section>
</main>

<style>
  /* The FAQ answers are rendered Markdown; these reproduce the utilities the handwritten markup
     carried: lower-alpha inside lists with gap-2.5, text-text font-bold emphasis, text-accent links. */
  .hpo-answer :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style-position: inside;
    list-style-type: lower-alpha;
  }
  .hpo-answer :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }
  .hpo-answer :global(a) {
    color: var(--color-accent);
  }
</style>
