---
// The lucide icons the app shell needs, as static SVG: four for the header's bottom tab bar, two
// for the unstake option cards, one for the swap link.
//
// The shell has to render the same glyphs the island does (Header.tsx imports them from
// lucide-react), and it cannot import a React component, so the paths are copied from
// lucide-react's icon nodes and the wrapper reproduces its defaultAttributes exactly — same
// viewBox, fill, stroke, stroke-width and linecaps, same `lucide` class. Re-check these against
// node_modules/lucide-react/dist/esm/icons/<name>.mjs when bumping lucide-react; a changed path
// would show up as the icon shifting the moment the island mounts.
interface Props {
  name: 'coins' | 'gift' | 'chart-line' | 'arrow-left-right' | 'arrow-right' | 'clock' | 'zap'
  class?: string
}

const { name, class: className } = Astro.props

const paths: Record<Props['name'], string[]> = {
  coins: [
    '<path d="M13.744 17.736a6 6 0 1 1-7.48-7.48"/>',
    '<path d="M15 6h1v4"/>',
    '<path d="m6.134 14.768.866-.5 2 3.464"/>',
    '<circle cx="16" cy="8" r="6"/>',
  ],
  gift: [
    '<path d="M12 7v14"/>',
    '<path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"/>',
    '<path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"/>',
    '<rect x="3" y="7" width="18" height="4" rx="1"/>',
  ],
  'chart-line': ['<path d="M3 3v16a2 2 0 0 0 2 2h16"/>', '<path d="m19 9-5 5-4-4-3 3"/>'],
  'arrow-left-right': [
    '<path d="M8 3 4 7l4 4"/>',
    '<path d="M4 7h16"/>',
    '<path d="m16 21 4-4-4-4"/>',
    '<path d="M20 17H4"/>',
  ],
  'arrow-right': ['<path d="M5 12h14"/>', '<path d="m12 5 7 7-7 7"/>'],
  clock: ['<circle cx="12" cy="12" r="10"/>', '<path d="M12 6v6l4 2"/>'],
  zap: [
    '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  ],
}
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width='24'
  height='24'
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linecap='round'
  stroke-linejoin='round'
  class={['lucide', className].filter(Boolean).join(' ')}
  aria-hidden='true'
  set:html={paths[name].join('')}
/>
