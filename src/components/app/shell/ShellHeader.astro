---
// Static mirror of src/components/app/Header.tsx, in its first-paint state: no wallet connected,
// the mobile menu closed. Rendered into the page at build time so the app chrome is already
// painted when the island arrives, instead of a spinner giving way to a header.
//
// Every class here is copied from Header.tsx and must stay copied — this markup exists to be
// pixel-identical to the island's first render, so any divergence shows up as the header shifting
// the moment React mounts. The interactive bits (menu toggle, Connect, tab navigation) are inert
// here: the island owns them a few hundred milliseconds later, and the nav items are real links
// that work without JavaScript in the meantime.
import { localizedPath, type Locale } from '../../../i18n/locale.ts'
import { getT } from '../../../i18n/t.ts'
import ShellIcon from './ShellIcon.astro'

interface Props {
  locale: Locale
  activePage: 'stake' | 'reward' | 'stats' | 'defi'
}

const { locale, activePage } = Astro.props
const { t } = getT(locale, ['app'])

// Same items in the same order as Header.tsx's `siteLinks`.
const siteLinks: { href: string; label: string; appPage?: Props['activePage'] }[] = [
  { href: '/', label: 'app.nav.home' },
  { href: '/hpo/', label: 'app.nav.hpo' },
  { href: '/docs/', label: 'app.nav.docs' },
  { href: '/faq/', label: 'app.nav.faq' },
  { href: '/stake/', label: 'app.nav.stake', appPage: 'stake' },
  { href: '/rewards/', label: 'app.nav.rewards', appPage: 'reward' },
  { href: '/stats/', label: 'app.nav.stats', appPage: 'stats' },
  { href: '/defi/', label: 'app.nav.defi', appPage: 'defi' },
]

// Same items in the same order as Header.tsx's `pages`.
const tabs: { page: Props['activePage']; label: string; icon: 'coins' | 'gift' | 'chart-line' | 'arrow-left-right' }[] =
  [
    { page: 'stake', label: 'app.nav.stake', icon: 'coins' },
    { page: 'reward', label: 'app.nav.rewards', icon: 'gift' },
    { page: 'stats', label: 'app.nav.stats', icon: 'chart-line' },
    { page: 'defi', label: 'app.nav.defi', icon: 'arrow-left-right' },
  ]
---

<div class='font-body text-text w-full'>
  <div class='mx-auto flex w-full max-w-[1280px] items-center justify-between gap-4 px-6 py-5 md:px-12'>
    <a href={localizedPath('/', locale)} class='flex flex-none items-center gap-2.5'>
      <img src='/images/hipo.svg' alt='Hipo' class='logo-on-dark size-9' />
      <img src='/images/hipo-light.svg' alt='Hipo' class='logo-on-light size-9' />
      <span class='font-fredoka text-2xl font-semibold'>Hipo</span>
    </a>

    <nav
      aria-label={t('app.header.siteNav')}
      class='text-text-muted hidden items-center gap-6 text-[15px] font-medium lg:flex'
    >
      {
        siteLinks.map(({ href, label, appPage }) => (
          <a
            href={localizedPath(href, locale)}
            class={appPage != null && appPage === activePage ? 'text-accent' : 'hover:text-accent'}
            set:text={t(label)}
          />
        ))
      }
    </nav>

    <div class='flex flex-none items-center gap-4'>
      <button
        type='button'
        class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover min-h-11 cursor-pointer rounded-full px-5 py-2.5 text-sm font-semibold'
        set:text={t('app.common.connectWallet')}
      />

      <button
        type='button'
        class='text-text cursor-pointer lg:hidden'
        title={t('app.header.toggleMenu')}
        aria-label={t('app.header.toggleMenu')}
      >
        <svg class='size-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16'></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    aria-label={t('app.header.appSections')}
    class='border-border bg-surface-deep fixed start-0 end-0 bottom-0 z-10 flex w-full flex-row border-t select-none lg:hidden'
  >
    {
      tabs.map(({ page, label, icon }) => (
        <a
          href={localizedPath(page === 'reward' ? '/rewards/' : `/${page}/`, locale)}
          aria-label={t(label)}
          aria-current={page === activePage ? 'page' : undefined}
          class={
            'flex min-h-12 flex-1 cursor-pointer flex-col items-center justify-center gap-0.5 py-1.5 text-xs font-medium ' +
            (page === activePage ? 'text-accent' : 'text-text-muted hover:text-accent')
          }
        >
          <ShellIcon name={icon} class='size-[18px]' />
          <span set:text={t(label)} />
        </a>
      ))
    }
  </nav>
</div>
