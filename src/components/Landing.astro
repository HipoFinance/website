<landing>
  <script src='/src/scripts/landing-data.js'></script>

  <!-- Hero -->
  <section
    class='mx-auto grid w-full max-w-[1280px] grid-cols-1 items-center gap-10 px-6 py-12 md:px-12 lg:grid-cols-[1.1fr_1fr]'
  >
    <div class='flex flex-col gap-[22px]'>
      <div
        class='border-border bg-surface text-text-muted flex w-fit items-center gap-2 rounded-full border px-3.5 py-[7px] text-sm font-medium'
      >
        <span class='bg-positive inline-block size-2 rounded-full'></span>
        Yearly rewards <strong id='heroApy' class='text-text'>—</strong> · Staking fee <span id='heroFee'>—</span>
      </div>

      <h1
        class='font-fredoka text-text text-[36px] leading-[1.1] font-semibold tracking-[-0.5px] sm:text-[48px] lg:text-[60px] lg:leading-[1.08]'
      >
        The #1 most profitable <span class='text-accent'>GRAM staking</span> on TON
      </h1>

      <p class='text-text-muted max-w-[460px] text-[17px] leading-[1.6] lg:text-[19px]'>
        Join <span id='heroHolders'>thousands of</span> GRAM holders earning passive income with Hipo — liquid, audited, and
        community-owned.
      </p>

      <div class='flex flex-wrap items-center gap-3.5'>
        <a
          href='/stake/'
          class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover rounded-full px-8 py-[15px] text-[17px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)] transition-colors'
        >
          Stake now
        </a>
        <a href='#how-it-works' class='text-text hover:text-accent px-5 py-[15px] text-[17px] font-medium'>
          How it works →
        </a>
      </div>
    </div>

    <div class='relative hidden justify-center lg:flex'>
      <div
        class='absolute inset-[8%_6%] rounded-full'
        style='background: radial-gradient(closest-side, var(--hero-glow), rgba(255,126,115,0));'
      >
      </div>
      <img
        src='/images/hipo-bank.webp'
        alt='Hipo piggy bank'
        class='relative w-[420px] max-w-full drop-shadow-[0_20px_40px_var(--art-shadow)]'
      />
    </div>
  </section>

  <!-- Stats row -->
  <section class='mx-auto grid w-full max-w-[1280px] grid-cols-2 gap-4 px-6 pt-2 pb-12 md:px-12 lg:grid-cols-4'>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div id='statStakedUsd' class='font-fredoka text-text text-[30px] font-semibold'>—</div>
      <div class='text-text-muted text-sm'>staked, worth <span id='statStaked'>—</span> GRAM</div>
    </div>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div id='statApy' class='font-fredoka text-accent text-[30px] font-semibold'>—</div>
      <div class='text-text-muted text-sm'>Yearly rewards, last round</div>
    </div>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div id='statHolders' class='font-fredoka text-text text-[30px] font-semibold'>—</div>
      <div class='text-text-muted text-sm'>GRAM holders staking</div>
    </div>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div id='statFee' class='font-fredoka text-text text-[30px] font-semibold'>—</div>
      <div class='text-text-muted text-sm'>Staking fee</div>
    </div>
  </section>

  <!-- How Hipo works -->
  <section id='how-it-works' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <h2 class='font-fredoka text-text mb-2 text-[32px] font-semibold sm:text-[40px]'>How Hipo works</h2>
    <p class='text-text-muted mb-7 text-lg'>Stake any amount of GRAM and earn more than just staking rewards.</p>

    <!-- Below sm the four steps plus the closing CTA are a snapping horizontal carousel rather than
         a five-deep stack (design handoff, Home.dc.html). The negative margin cancels the section's
         px-6 so cards can bleed to the screen edge while the first one still lines up with the
         heading, and scroll-p-6 puts the snapped card back on that line. Card width is
         min(260px, 78vw), which always leaves the next card peeking as the scroll affordance — that
         peek is why the scrollbar can be hidden. From sm up this reverts to the plain responsive
         grid, where the CTA spans the full width on its own row instead of squeezing the steps into
         a fifth column. -->
    <div
      class='-mx-6 grid snap-x snap-mandatory scroll-p-6 [scrollbar-width:none] auto-cols-[minmax(min(260px,78vw),1fr)] grid-flow-col gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid-flow-row sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 [&::-webkit-scrollbar]:hidden'
    >
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/images/gram-3d.svg' alt='GRAM' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>1 · Stake GRAM</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>
          Deposit your GRAM into Hipo to earn the highest staking rewards in the market.
        </div>
      </div>
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/images/hgram-3d.svg' alt='hGRAM' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>2 · Get liquid hGRAM</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>
          Get hGRAM representing your staked GRAM. Its value grows as rewards accumulate, and it works across TON DeFi.
        </div>
      </div>
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/hpo.png' alt='HPO' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>3 · Earn free HPO</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>
          Stakers also earn HPO through Hipo Club — both come free with staking, nothing extra to pay.
          <a href='#hipo-club' class='text-accent hover:text-accent-hover'>Meet Hipo Club →</a>
        </div>
      </div>
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/images/gram.svg' alt='Unstake' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>4 · Unstake anytime</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>
          Return your hGRAM whenever you want. You'll receive GRAM plus your accumulated staking rewards.
        </div>
      </div>

      <!-- Closing CTA, not a fifth step: the carousel ends on the way into the app. -->
      <div
        class='border-border flex snap-start flex-col items-start justify-between gap-4 rounded-[20px] border p-6 sm:col-span-2 sm:flex-row sm:items-center sm:gap-8 sm:p-8 lg:col-span-4'
        style='background: linear-gradient(120deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%);'
      >
        <div class='flex flex-col gap-2.5'>
          <div class='font-fredoka text-text text-xl font-semibold sm:text-[28px]'>Start Staking GRAM</div>
          <div class='text-text-muted text-[15px] leading-[1.55] sm:text-[17px] sm:leading-[1.6]'>
            Start earning rewards and bonuses with as low as 1 GRAM.
          </div>
        </div>
        <a
          href='/stake/'
          class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover flex-none rounded-full px-[30px] py-3.5 text-base font-semibold shadow-[0_6px_0_var(--color-accent-shadow)] transition-colors'
        >
          Stake now
        </a>
      </div>
    </div>
  </section>

  <!-- Hipo Community -->
  <section id='hipo-community' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <div
      class='border-border flex flex-col items-center justify-between gap-10 rounded-[28px] border p-8 lg:flex-row lg:p-12'
