---
// Landing page body. Every visible string comes from src/i18n/<locale>/landing.json; the live
// numbers (#heroApy, #statStaked, ...) are baked in at build time by src/data/gauge.ts and then
// refreshed in the browser by src/scripts/landing-data.js, which formats them through the very
// same gaugeValues() — so the client write is character-identical and nothing visibly flips. Each
// one falls back to the placeholder it used to always ship when the gauge is unreachable. Where a
// sentence wraps a live element or an accent span, the element is built here and interpolated into
// the catalog sentence via tHtml, so translators can move it freely.
import { localeOf, localizedPath } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import { fetchGauge, gaugeValues } from '../data/gauge.ts'

const locale = localeOf(Astro)
const { t, tHtml } = getT(locale, ['landing'])

const gauge = gaugeValues(locale, await fetchGauge())
// Pre-rendered attribute for the two staked figures, whose compact value carries the exact amount
// as a tooltip (landing-data.js sets the same title on both when it refreshes).
const stakedTitle = gauge.stakedExact === undefined ? '' : ` title="${gauge.stakedExact}"`

const audits = [
  {
    href: 'https://github.com/HipoFinance/audits?tab=readme-ov-file#2025-04-quantstamp-hipo-audit-report',
    name: 'Quantstamp',
    logo: '/images/quantstamp.svg',
    scope: t('landing.audits.v2'),
    date: t('landing.audits.quantstampDate'),
  },
  {
    href: 'https://github.com/HipoFinance/audits?tab=readme-ov-file#2024-03-programcrafter-hipo-audit-report',
    name: 'ProgramCrafter',
    initials: 'PC',
    gradient: 'from-green-900 to-green-500',
    scope: t('landing.audits.v2'),
    date: t('landing.audits.programCrafterDate'),
  },
  {
    href: 'https://github.com/HipoFinance/audits#2023-10-tontech-hipo-audit-report',
    name: 'TonTech',
    logo: '/images/tontech.svg',
    scope: t('landing.audits.v1'),
    date: t('landing.audits.tontechDate'),
  },
  {
    href: 'https://github.com/HipoFinance/audits#2023-10-daniil-sedov-hipo-audit-report',
    name: 'Daniil Sedov',
    initials: 'DS',
    gradient: 'from-blue-900 to-blue-500',
    scope: t('landing.audits.v1'),
    date: t('landing.audits.sedovDate'),
  },
]

const why = [
  { icon: '/images/graph.png', iconClass: 'size-11 self-start object-contain', key: 'apy' },
  { icon: '/images/heart-shine.svg', iconClass: 'size-11 self-start', key: 'community' },
  { icon: '/images/audit-shield.svg', iconClass: 'size-11 self-start', key: 'audited' },
  { icon: '/images/decentralized.svg', iconClass: 'size-11 self-start', key: 'decentralized' },
]
---

<landing>
  <script src='/src/scripts/landing-data.js'></script>

  <!-- Hero -->
  <section
    class='mx-auto grid w-full max-w-[1280px] grid-cols-1 items-center gap-10 px-6 py-12 md:px-12 lg:grid-cols-[1.1fr_1fr]'
  >
    <div class='flex flex-col gap-[22px]'>
      <div
        class='border-border bg-surface text-text-muted flex w-fit items-center gap-2 rounded-full border px-3.5 py-[7px] text-sm font-medium'
      >
        <span class='bg-positive inline-block size-2 rounded-full'></span>
        <Fragment
          set:html={tHtml('landing.hero.pill', {
            apy: `<strong id="heroApy" class="text-text">${gauge.heroApy ?? '—'}</strong>`,
            fee: `<span id="heroFee">${gauge.heroFee ?? '—'}</span>`,
          })}
        />
      </div>

      <h1
        class='font-fredoka text-text text-[36px] leading-[1.1] font-semibold tracking-[-0.5px] sm:text-[48px] lg:text-[60px] lg:leading-[1.08]'
        set:html={tHtml('landing.hero.title', {
          accent: `<span class="text-accent">${t('landing.hero.titleAccent')}</span>`,
        })}
      />

      <p
        class='text-text-muted max-w-[460px] text-[17px] leading-[1.6] lg:text-[19px]'
        set:html={tHtml('landing.hero.lead', {
          holders: `<span id="heroHolders">${gauge.heroHolders ?? t('landing.hero.holdersPlaceholder')}</span>`,
        })}
      />

      <div class='flex flex-wrap items-center gap-3.5'>
        <a
          href={localizedPath('/stake/', locale)}
          class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover rounded-full px-8 py-[15px] text-[17px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)] transition-colors'
        >
          {t('landing.hero.stakeNow')}
        </a>
        <a href='#how-it-works' class='text-text hover:text-accent px-5 py-[15px] text-[17px] font-medium'>
          {t('landing.hero.howItWorks')}
        </a>
      </div>
    </div>

    <div class='relative hidden justify-center lg:flex'>
      <div
        class='absolute inset-[8%_6%] rounded-full'
        style='background: radial-gradient(closest-side, var(--hero-glow), rgba(255,126,115,0));'
      >
      </div>
      <!-- The wrapper above is `hidden lg:flex`, so this art never appears on a phone — but a bare
           <img src> is fetched by the preload scanner before any CSS says so, which spent 107 KB of
           a mobile visitor's bandwidth against the LCP paint. The <source media> is honoured by the
           scanner itself, so narrow viewports resolve to the 1x1 data URI and request nothing;
           desktop still gets the webp eagerly, high priority, exactly as before.
           width/height carry the intrinsic 800x800 so the box is reserved before the bytes land. -->
      <picture>
        <source media='(min-width: 1024px)' srcset='/images/hipo-bank.webp' type='image/webp' />
        <img
          src='data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
          alt={t('landing.hero.imageAlt')}
          width='800'
          height='800'
          class='relative w-[420px] max-w-full drop-shadow-[0_20px_40px_var(--art-shadow)]'
        />
      </picture>
    </div>
  </section>

  <!-- Stats row -->
  <section class='mx-auto grid w-full max-w-[1280px] grid-cols-2 gap-4 px-6 pt-2 pb-12 md:px-12 lg:grid-cols-4'>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div
        id='statStakedUsd'
        title={gauge.stakedExact}
        class='font-fredoka text-text text-[30px] font-semibold'
        set:text={gauge.statStakedUsd ?? '—'}
      />
      <div
        class='text-text-muted text-sm'
        set:html={tHtml('landing.stats.stakedCaption', {
          amount: `<span id="statStaked"${stakedTitle}>${gauge.statStaked ?? '—'}</span>`,
        })}
      />
    </div>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div id='statApy' class='font-fredoka text-accent text-[30px] font-semibold' set:text={gauge.statApy ?? '—'} />
      <div class='text-text-muted text-sm'>{t('landing.stats.apyCaption')}</div>
    </div>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div
        id='statHolders'
        class='font-fredoka text-text text-[30px] font-semibold'
        set:text={gauge.statHolders ?? '—'}
      />
      <div class='text-text-muted text-sm'>{t('landing.stats.holdersCaption')}</div>
    </div>
    <div class='border-border bg-surface rounded-[20px] border px-6 py-5'>
      <div id='statFee' class='font-fredoka text-text text-[30px] font-semibold' set:text={gauge.statFee ?? '—'} />
      <div class='text-text-muted text-sm'>{t('landing.stats.feeCaption')}</div>
    </div>
  </section>

  <!-- How Hipo works -->
  <section id='how-it-works' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <h2 class='font-fredoka text-text mb-2 text-[32px] font-semibold sm:text-[40px]'>{t('landing.how.title')}</h2>
    <p class='text-text-muted mb-7 text-lg'>{t('landing.how.subtitle')}</p>

    <!-- Below sm the four steps plus the closing CTA are a snapping horizontal carousel rather than
         a five-deep stack (design handoff, Home.dc.html). The negative margin cancels the section's
         px-6 so cards can bleed to the screen edge while the first one still lines up with the
         heading, and scroll-p-6 puts the snapped card back on that line. Card width is
         min(260px, 78vw), which always leaves the next card peeking as the scroll affordance — that
         peek is why the scrollbar can be hidden. From sm up this reverts to the plain responsive
         grid, where the CTA spans the full width on its own row instead of squeezing the steps into
         a fifth column. -->
    <div
      class='-mx-6 grid snap-x snap-mandatory scroll-p-6 [scrollbar-width:none] auto-cols-[minmax(min(260px,78vw),1fr)] grid-flow-col gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid-flow-row sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 [&::-webkit-scrollbar]:hidden'
    >
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/images/gram-3d.svg' alt='GRAM' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>{t('landing.how.step1.title')}</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>{t('landing.how.step1.body')}</div>
      </div>
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/images/hgram-3d.svg' alt='hGRAM' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>{t('landing.how.step2.title')}</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>{t('landing.how.step2.body')}</div>
      </div>
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/hpo.png' alt='HPO' class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>{t('landing.how.step3.title')}</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>
          {t('landing.how.step3.body')}
          <a href='#hipo-club' class='text-accent hover:text-accent-hover'>{t('landing.how.step3.link')}</a>
        </div>
      </div>
      <div class='border-border bg-surface flex snap-start flex-col gap-3 rounded-[20px] border p-6'>
        <img src='/images/gram.svg' alt={t('landing.how.step4.imageAlt')} class='size-[52px]' />
        <div class='font-fredoka text-text text-xl font-semibold'>{t('landing.how.step4.title')}</div>
        <div class='text-text-muted text-[15px] leading-[1.55]'>{t('landing.how.step4.body')}</div>
      </div>

      <!-- Closing CTA, not a fifth step: the carousel ends on the way into the app. -->
      <div
        class='border-border flex snap-start flex-col items-start justify-between gap-4 rounded-[20px] border p-6 sm:col-span-2 sm:flex-row sm:items-center sm:gap-8 sm:p-8 lg:col-span-4'
        style='background: linear-gradient(120deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%);'
      >
        <div class='flex flex-col gap-2.5'>
          <div class='font-fredoka text-text text-xl font-semibold sm:text-[28px]'>{t('landing.how.cta.title')}</div>
          <div class='text-text-muted text-[15px] leading-[1.55] sm:text-[17px] sm:leading-[1.6]'>
            {t('landing.how.cta.body')}
          </div>
        </div>
        <a
          href={localizedPath('/stake/', locale)}
          class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover flex-none rounded-full px-[30px] py-3.5 text-base font-semibold shadow-[0_6px_0_var(--color-accent-shadow)] transition-colors'
        >
          {t('landing.how.cta.button')}
        </a>
      </div>
    </div>
  </section>

  <!-- Hipo Community -->
  <section id='hipo-community' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <div
      class='border-border flex flex-col items-center justify-between gap-10 rounded-[28px] border p-8 lg:flex-row lg:p-12'
      style='background: linear-gradient(240deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%);'
    >
      <div class='flex max-w-[560px] flex-col items-center gap-2.5 text-center lg:items-start lg:text-start'>
        <img src='/images/heart-shine.svg' alt='' class='size-11' />
        <h2 class='font-fredoka text-text text-[28px] font-semibold sm:text-[36px]'>{t('landing.community.title')}</h2>
        <p class='text-text-muted text-[17px] leading-[1.6]'>
          <strong class='text-text'>{t('landing.community.lead')}</strong>
          {t('landing.community.body')}
        </p>
      </div>
      <a
        href='https://t.me/hipo_chat'
        target='_blank'
        rel='noopener noreferrer'
        class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover flex-none rounded-full px-[30px] py-3.5 text-base font-semibold'
      >
        {t('landing.community.cta')}
      </a>
    </div>
  </section>

  <!-- Hipo Club -->
  <section id='hipo-club' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <div
      class='border-border flex flex-col items-center justify-between gap-10 rounded-[28px] border p-8 lg:flex-row lg:p-12'
      style='background: linear-gradient(120deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%);'
    >
      <div class='flex max-w-[560px] flex-col items-center gap-2.5 text-center lg:items-start lg:text-start'>
        <img src='/images/star-shine.svg' alt='' class='size-11' />
        <h2 class='font-fredoka text-text text-[28px] font-semibold sm:text-[36px]'>{t('landing.club.title')}</h2>
        <p class='text-text-muted text-[17px] leading-[1.6]'>
          {t('landing.club.body')}
          <a
            href={localizedPath('/docs/giveaways-and-prizes/hipo-club/', locale)}
            class='text-accent hover:text-accent-hover'>{t('landing.club.learnMore')}</a
          >
        </p>
      </div>
      <a
        href='https://t.me/HipoFinanceBot/join'
        target='_blank'
        rel='noopener noreferrer'
        class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover flex-none rounded-full px-[30px] py-3.5 text-base font-semibold'
      >
        {t('landing.club.cta')}
      </a>
    </div>
  </section>

  <!-- HPO panel -->
  <section id='hpo' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <div
      class='border-border bg-surface grid grid-cols-1 items-center gap-10 rounded-[28px] border p-8 lg:grid-cols-2 lg:p-12'
    >
      <div class='flex flex-col items-start gap-4'>
        <h2 class='font-fredoka text-text text-[28px] font-semibold sm:text-[36px]'>{t('landing.hpo.title')}</h2>
        <p class='text-text-muted text-[17px] leading-[1.6]'>{t('landing.hpo.body')}</p>

        <div class='flex flex-wrap gap-7 py-1.5'>
          <div>
            <div
              id='hpoMarketCap'
              class='font-fredoka text-text text-2xl font-semibold'
              set:text={gauge.hpoMarketCap ?? '—'}
            />
            <div class='text-text-muted text-[13px]'>{t('landing.hpo.marketCap')}</div>
          </div>
          <div>
            <div
              id='hpoVolume'
              class='font-fredoka text-text text-2xl font-semibold'
              set:text={gauge.hpoVolume ?? '—'}
            />
            <div class='text-text-muted text-[13px]'>{t('landing.hpo.volume')}</div>
          </div>
          <div>
            <div
              id='hpoHolders'
              class='font-fredoka text-text text-2xl font-semibold'
              set:text={gauge.hpoHolders ?? '—'}
            />
            <div class='text-text-muted text-[13px]'>{t('landing.hpo.holders')}</div>
          </div>
        </div>

        <div class='flex flex-wrap items-center gap-3.5'>
          <a
            href='https://app.ston.fi/swap?chartVisible=false&ft=TON&tt=HPO'
            target='_blank'
            rel='noopener noreferrer'
            class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover rounded-full px-7 py-[13px] text-base font-semibold'
          >
            {t('landing.hpo.buy')}
          </a>
          <a href={localizedPath('/hpo/', locale)} class='text-accent hover:text-accent-hover text-base font-medium'>
            {t('landing.hpo.learnMore')}
          </a>
        </div>
      </div>

      <div class='flex justify-center'>
        <img
          src='/hpo.png'
          alt={t('landing.hpo.imageAlt')}
          class='w-[220px] drop-shadow-[0_16px_32px_var(--art-shadow-soft)]'
        />
      </div>
    </div>
  </section>

  <!-- Why Hipo -->
  <section id='why-hipo' class='mx-auto w-full max-w-[1280px] px-6 py-12 md:px-12'>
    <h2 class='font-fredoka text-text mb-2 text-[32px] font-semibold sm:text-[40px]'>{t('landing.why.title')}</h2>
    <p class='text-text-muted mb-7 text-lg'>{t('landing.why.subtitle')}</p>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {
        why.map(({ icon, iconClass, key }) => (
          <div class='border-border bg-surface flex flex-col gap-2.5 rounded-[20px] border p-6'>
            <img src={icon} alt='' class={iconClass} />
            <div class='font-fredoka text-text text-[19px] font-semibold'>{t(`landing.why.${key}.title`)}</div>
            <div class='text-text-muted text-[15px] leading-[1.55]'>{t(`landing.why.${key}.body`)}</div>
          </div>
        ))
      }
    </div>
  </section>
  <!-- Security audits -->
  <section id='audits' class='mx-auto w-full max-w-[1280px] px-6 pt-12 pb-18 md:px-12'>
    <div class='flex flex-wrap items-baseline justify-between gap-2'>
      <h2 class='font-fredoka text-text mb-2 text-[32px] font-semibold sm:text-[40px]'>{t('landing.audits.title')}</h2>
      <a
        href='https://github.com/HipoFinance/audits'
        target='_blank'
        rel='noopener noreferrer'
        class='text-accent hover:text-accent-hover text-[15px] font-medium'
      >
        {t('landing.audits.allReports')}
      </a>
    </div>
    <p class='text-text-muted mb-7 text-lg'>{t('landing.audits.subtitle')}</p>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      {
        audits.map((audit) => (
          <a
            href={audit.href}
            target='_blank'
            rel='noopener noreferrer'
            class='border-border bg-surface flex flex-col gap-2 rounded-[20px] border p-[22px] transition-transform hover:scale-[1.02]'
          >
            <span class='text-text flex items-center gap-2 text-[17px] font-semibold'>
              {audit.logo ? (
                <span class='bg-mark-chip flex size-[26px] items-center justify-center rounded-full'>
                  <img src={audit.logo} alt='' class='h-4' />
                </span>
              ) : (
                <span
                  class={`text-on-gradient flex size-[26px] items-center justify-center rounded-full bg-gradient-to-t ${audit.gradient} text-[11px] font-light`}
                >
                  {audit.initials}
                </span>
              )}
              {audit.name}
            </span>
            <span class='text-text-muted text-[15px]'>{audit.scope}</span>
            <span class='text-text-faint text-[13px]'>{audit.date}</span>
          </a>
        ))
      }
    </div>
  </section>
</landing>
