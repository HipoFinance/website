---
// The docs bar (specs/docs-site-chrome.md): the first row of the docs content, below the site header
// that PageFrame.astro renders. Overrides Starlight's Header (~0.40), which used to be the docs' own
// top bar with its own title, links and language select; the site header carries all of those now.
// It holds the section's name (a link to the docs home), Starlight's search field and, below lg, the
// "Contents" button that opens the docs menu (its script is in PageFrame.astro, next to the menu).
// A <div>, not a <header>: the page already has the site's banner landmark.
import config from 'virtual:starlight/user-config'
import Search from 'virtual:starlight/components/Search'
import { localizedPath } from '../../i18n/locale'
import { getT } from '../../i18n/t'
import { isLocaleKey } from '../../i18n/registry.mjs'

const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro'
// Starlight reports `undefined` for the root locale; our locale keys double as Starlight's.
const routeLocale = Astro.locals.starlightRoute.locale
const locale = routeLocale !== undefined && isLocaleKey(routeLocale) ? routeLocale : 'en'
const { t } = getT(locale, ['site'])
const { hasSidebar } = Astro.locals.starlightRoute
---

<div class='hipo-docs-bar print:hidden'>
  <a href={localizedPath('/docs/', locale)} class='hipo-docs-title font-display font-heading text-text text-title'>
    {t('site.footer.documentation')}
  </a>
  <div class='hipo-docs-tools'>
    {
      hasSidebar && (
        <button
          type='button'
          class='hipo-docs-menu-button'
          data-docs-menu-toggle
          aria-expanded='false'
          aria-controls='hipo-docs-nav'
        >
          <svg class='size-4' fill='none' stroke='currentColor' stroke-width='2' viewBox='0 0 24 24' aria-hidden='true'>
            <path stroke-linecap='round' d='M4 6h16M4 12h16M4 18h10' />
          </svg>
          {Astro.locals.t('hipo.docs.contents')}
          <svg
            class='hipo-docs-menu-caret size-3'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            viewBox='0 0 24 24'
            aria-hidden='true'
          >
            <path stroke-linecap='round' stroke-linejoin='round' d='m6 9 6 6 6-6' />
          </svg>
        </button>
      )
    }
    {shouldRenderSearch && <Search />}
  </div>
</div>
