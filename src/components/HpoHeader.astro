---
// Warm Dark header for the HPO page. Mirrors the nav pattern in the design handoff
// (HPO.dc.html), with the "HPO" item active in coral. Owned by src/pages/hpo/index.astro only.
---

<header class='mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-6 py-5 sm:px-12'>
  <a href='/' class='flex items-center gap-2.5'>
    <span class='bg-text inline-flex size-9 items-center justify-center rounded-full'>
      <img src='/images/hipo.svg' class='size-6' alt='Hipo' />
    </span>
    <span class='font-fredoka text-2xl font-semibold'>Hipo</span>
  </a>

  <nav class='text-text-muted hidden items-center gap-8 text-[15px] font-medium md:flex'>
    <a href='/' class='hover:text-accent'>Home</a>
    <a href='/hpo/' class='text-accent'>HPO</a>
    <a href='/docs/' class='hover:text-accent'>Docs</a>
    <a href='/faq/' class='hover:text-accent'>FAQ</a>
    <a href='https://stats.hipo.finance/' target='_blank' rel='noopener noreferrer' class='hover:text-accent'>Stats</a>
  </nav>

  <a
    href='/stake/'
    class='bg-accent text-on-accent hover:bg-accent-hover rounded-full px-6 py-2.5 text-[15px] font-semibold'
  >
    Open app
  </a>
</header>
