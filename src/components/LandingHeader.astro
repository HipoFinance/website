---
interface Props {
  // Which landing-layout page this header renders on. Swaps the first nav item ('How it works'
  // in-page anchor vs. 'Home') and highlights the current page's own nav item in coral.
  page?: 'home' | 'faq'
}

const { page = 'home' } = Astro.props
---

<header>
  <script src='/src/scripts/landing-menu.js'></script>

  <div class='mx-auto flex w-full max-w-[1280px] items-center justify-between px-6 py-5 md:px-12'>
    <a href='/' class='flex items-center gap-2.5'>
      <span class='bg-text flex size-9 items-center justify-center rounded-full'>
        <img src='/images/hipo.svg' alt='Hipo' class='size-6' />
      </span>
      <span class='font-fredoka text-text text-2xl font-semibold'>Hipo</span>
    </a>

    <nav class='text-text-muted hidden items-center gap-8 text-[15px] font-medium md:flex'>
      {
        page === 'home' ? (
          <a href='#how-it-works' class='hover:text-accent'>
            How it works
          </a>
        ) : (
          <a href='/' class='hover:text-accent'>
            Home
          </a>
        )
      }
      <a href='/hpo/' class='hover:text-accent'>HPO</a>
      <a href='/docs/' class='hover:text-accent'>Docs</a>
      <a href='/faq/' class={page === 'faq' ? 'text-accent' : 'hover:text-accent'}>FAQ</a>
      <a href='/stats/' class='hover:text-accent'>Stats</a>
    </nav>

    <div class='flex items-center gap-4'>
      <a
        href='/stake/'
        class='bg-accent text-on-accent hover:bg-accent-hover hidden rounded-full px-6 py-[11px] text-[15px] font-semibold md:inline-block'
      >
        Open app
      </a>

      <button id='menu-button' class='text-text md:hidden' title='Toggle mobile menu' aria-label='Toggle mobile menu'>
        <svg class='size-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16'></path>
        </svg>
      </button>
    </div>
  </div>

  <div id='mobile-menu' class='hidden px-6 pb-6 md:hidden'>
    <nav class='text-text-muted flex flex-col gap-1 text-[15px] font-medium'>
      {
        page === 'home' ? (
          <a href='#how-it-works' class='hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5'>
            How it works
          </a>
        ) : (
          <a href='/' class='hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5'>
            Home
          </a>
        )
      }
      <a href='/hpo/' class='hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5'>HPO</a>
      <a href='/docs/' class='hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5'>Docs</a>
      <a
        href='/faq/'
        class={`rounded-lg px-3 py-2.5 hover:bg-surface hover:text-accent ${page === 'faq' ? 'text-accent' : ''}`}
      >
        FAQ
      </a>
      <a href='/stats/' class='hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5'>Stats</a>
      <a href='/stake/' class='bg-accent text-on-accent mt-2 rounded-full px-6 py-2.5 text-center font-semibold'>
        Open app
      </a>
    </nav>
  </div>
</header>
