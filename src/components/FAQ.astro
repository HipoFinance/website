---
import { getCollection, render } from 'astro:content'
import { localeOf } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import { FAQ_SECTIONS } from './faqSections.ts'

const locale = localeOf(Astro)
const { t } = getT(locale, ['faq'])

// Section ids stay the English slugs in every locale (stable deep links) and come from
// faqSections.ts, shared with the FAQPage JSON-LD so both follow the same order; headings and nav
// labels come from the faq catalog. Answers come from the `prose` collection:
// src/content/prose/<locale>/faq/<section>/<anchor-id>.md (the file name is the anchor).
const sections = FAQ_SECTIONS.map(({ id, key }) => ({
  id,
  heading: t(`faq.section.${key}.heading`),
  nav: t(`faq.section.${key}.nav`),
}))

const prefix = `${locale}/faq/`
const entries = await getCollection('prose', (entry) => entry.id.startsWith(prefix))
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    anchor: entry.id.slice(entry.id.lastIndexOf('/') + 1),
    Content: (await render(entry)).Content,
  })),
)
// Grouped by frontmatter `section` (the directory is convention only). A section with no entries
// still renders its heading, so every section anchor exists in every locale.
const groups = sections.map((section) => ({
  ...section,
  items: rendered
    .filter(({ entry }) => entry.data.section === section.id)
    .sort((a, b) => a.entry.data.order - b.entry.data.order),
}))
---

<script src='/src/scripts/faq-anchors.ts'></script>

<faq>
  <div
    class='mx-auto grid w-full max-w-[1180px] grid-cols-1 gap-8 px-6 pt-10 pb-20 md:px-12 lg:grid-cols-[220px_1fr] lg:items-start lg:gap-14'
  >
    <nav class='flex flex-row flex-wrap gap-1 text-[15px] font-medium lg:sticky lg:top-8 lg:flex-col'>
      <span
        class='text-text-faint hidden w-full px-3 pb-2 text-[13px] font-semibold tracking-[.08em] uppercase lg:block'
      >
        {t('faq.page.sections')}
      </span>
      {
        sections.map((section, i) => (
          <a
            href={`#${section.id}`}
            class:list={[
              'rounded-[10px] px-3 py-2',
              i === 0 ? 'bg-surface text-text' : 'text-text-muted hover:bg-surface hover:text-text',
            ]}
          >
            {section.nav}
          </a>
        ))
      }
    </nav>

    <div class='flex min-w-0 flex-col gap-2'>
      <h1 class='font-fredoka text-text mb-6 text-[32px] font-semibold sm:text-[44px]'>{t('faq.page.title')}</h1>

      {
        groups.map((group, gi) => (
          <section id={group.id} class='scroll-mt-6 pb-6'>
            <h2 class='font-fredoka text-accent mb-4 text-2xl font-semibold sm:text-[26px]'>{group.heading}</h2>
            <div class='flex flex-col gap-3'>
              {group.items.map(({ entry, anchor, Content }, i) => (
                <details
                  id={anchor}
                  open={gi === 0 && i === 0}
                  class='border-border bg-surface scroll-mt-6 rounded-2xl border px-[22px] py-[18px]'
                >
                  <summary class='text-text cursor-pointer text-[17px] font-medium'>{entry.data.question}</summary>
                  <div class='prose-answer text-text-muted pt-3 text-[15px] leading-[1.6]'>
                    <Content />
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</faq>

<style>
  /* The answers are rendered Markdown, so the per-element utilities the handwritten markup carried
     (mb-2.5 on all but the last block, list-disc/list-decimal ps-6, text-accent links) live here. */
  .prose-answer :global(:is(p, ul, ol):not(:last-child)) {
    margin-block-end: 0.625rem;
  }
  .prose-answer :global(ul),
  .prose-answer :global(ol) {
    padding-inline-start: 1.5rem;
  }
  .prose-answer :global(ul) {
    list-style-type: disc;
  }
  .prose-answer :global(ol) {
    list-style-type: decimal;
  }
  .prose-answer :global(a) {
    color: var(--color-accent);
  }
  @media (hover: hover) {
    .prose-answer :global(a:hover) {
      color: var(--color-accent-hover);
    }
  }
</style>
