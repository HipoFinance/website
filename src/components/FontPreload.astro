---
// Preloads the woff2 faces that paint the first screen, for this page's locale.
//
// Without them the chain is HTML → global.css (65 KB) → woff2: the first paint uses the fallback
// face and the page reflows when the real one lands. That reflow is what Search Console measures
// as CLS on `/` — the hero <h1> is `font-fredoka`, three lines at 36px on a phone, and a line-count
// change there moves the whole document.
//
// The `?url` imports go through Vite's asset pipeline, so they resolve to the same hashed files
// i18n-fonts.css and global.css already reference — a preload, not a second copy. Keep the paths in
// step with the @font-face `src`s in src/styles/i18n-fonts.css; a stale one here downloads a file
// nothing then uses.
//
// `crossorigin` is required even though the files are same-origin: font fetches are always made in
// CORS mode, and a preload without it is a second, separate download rather than a warm cache hit.
//
// Two faces at most, and never more than ~60 KB: this is meant to arrive alongside the render-
// blocking stylesheet, not to compete with it. Where a locale's display face is too heavy to fit
// that budget (Persian's Lalezar at 52 KB, Hindi's Baloo 2 at 115 KB) only the body face is
// preloaded — it covers far more of the first screen, and the headings still swap as they do today.
import type { Locale } from '../i18n/locale.ts'

import fredokaLatin from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url'
import heeboLatin400 from '@fontsource/heebo/files/heebo-latin-400-normal.woff2?url'
import vazirmatnArabic from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url'
import cairoArabic from '@fontsource-variable/cairo/files/cairo-arabic-wght-normal.woff2?url'
import nunitoCyrillic from '@fontsource-variable/nunito/files/nunito-cyrillic-wght-normal.woff2?url'
import robotoCyrillic from '@fontsource-variable/roboto/files/roboto-cyrillic-wght-normal.woff2?url'
import poppinsDevanagari400 from '@fontsource/poppins/files/poppins-devanagari-400-normal.woff2?url'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

// Display face first, then body — the heading is both the LCP element and the biggest shift.
// Locales absent from this map are the Latin ones (en de tr it id pt-BR), which keep Heebo +
// Fredoka; see the family tokens at the foot of i18n-fonts.css.
const PER_LOCALE: Partial<Record<Locale, string[]>> = {
  fa: [vazirmatnArabic],
  ar: [cairoArabic], // Cairo is both the body and the display face for ar, so one file covers both.
  ru: [nunitoCyrillic, robotoCyrillic],
  hi: [poppinsDevanagari400],
}

const faces = PER_LOCALE[locale] ?? [fredokaLatin, heeboLatin400]
---

{faces.map((href) => <link rel='preload' as='font' type='font/woff2' href={href} crossorigin />)}
