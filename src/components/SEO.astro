---
// src/components/SEO.astro

interface Props {
  title: string
  description: string
  image?: string
  publishedTime?: string
  author?: string
  jsonLd?: Record<string, any>
}

const { title, description, image = '/og/default.png', publishedTime, author, jsonLd } = Astro.props

const url = Astro.url.href
const imageUrl = new URL(image, Astro.site).href
---

<!-- BASIC -->
<title>{title}</title>
<meta name='description' content={description} />
<meta name='viewport' content='width=device-width, initial-scale=1' />
<link rel='canonical' href={url} />

<!-- THEME -->
<!-- The site follows `prefers-color-scheme` and has no toggle, so the browser chrome can be
     declared statically. `dark light` puts dark first: that is the palette a browser with no
     preference gets, matching the base @theme block in src/styles/global.css. Kept here rather
     than in CSS so it applies before the stylesheet lands. Starlight owns its own <head> and does
     not render this component; it sets the same thing itself from `data-theme`. -->
<meta name='color-scheme' content='dark light' />
<meta name='theme-color' content='#201b1a' media='(prefers-color-scheme: dark)' />
<meta name='theme-color' content='#faf6ef' media='(prefers-color-scheme: light)' />

<!-- OPEN GRAPH -->
<meta property='og:type' content='website' />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:url' content={url} />
<meta property='og:image' content={imageUrl} />

<!-- optional article OG -->
{publishedTime && <meta property='article:published_time' content={publishedTime} />}
{author && <meta property='article:author' content={author} />}

<!-- TWITTER -->
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={imageUrl} />

<!-- JSON-LD -->
{jsonLd && <script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />}
