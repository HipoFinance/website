---
// Head tags shared by the landing, HPO and app layouts (Starlight owns its own head). The
// alternate-language links cover English plus every indexable locale (spec §H): with an English-only
// registry that is exactly hreflang="en" and x-default, both pointing at the current URL. Draft
// locales (status 'draft', built only when I18N_INCLUDE_DRAFTS=1 for local preview) are never linked
// here and get their own page noindex'd below, so a drafts build never changes what crawlers see.
import { DEFAULT_LOCALE, LOCALES, indexableLocales } from '../i18n/registry.mjs'
import { langOf, localeOf, localizedPath, stripLocale } from '../i18n/locale.ts'
import Analytics from './Analytics.astro'

interface Props {
  title: string
  description: string
  image?: string
  publishedTime?: string
  author?: string
  jsonLd?: Record<string, any>
  // English-only pages (/verify/, /vs/) set this to false: they have no `[locale]` twin, so
  // pointing hreflang at `/fa/verify/` would advertise URLs that 404. Everything else keeps the
  // default and gets the full alternate set.
  localized?: boolean
}

const { title, description, image = '/og/default.png', publishedTime, author, jsonLd, localized = true } = Astro.props

const locale = localeOf(Astro)
const url = Astro.url.href
const imageUrl = new URL(image, Astro.site).href

// The same page in every indexable locale, for hreflang and og:locale:alternate — draft locales
// (built only when I18N_INCLUDE_DRAFTS=1) are never linked, even in a drafts build.
const { path } = stripLocale(Astro.url.pathname)
const alternates = (localized ? indexableLocales() : []).map((l) => ({
  locale: l,
  lang: langOf(l),
  href: new URL(localizedPath(path, l), Astro.site).href,
}))
const englishUrl = new URL(localizedPath(path, DEFAULT_LOCALE), Astro.site).href
const isDraft = LOCALES[locale]?.status === 'draft'
---

<!-- BASIC -->
<title>{title}</title>
<meta name='description' content={description} />
<meta name='viewport' content='width=device-width, initial-scale=1' />
{isDraft && <meta name='robots' content='noindex, nofollow' />}
<link rel='canonical' href={url} />
{alternates.map((alt) => <link rel='alternate' hreflang={alt.lang} href={alt.href} />)}
{localized && <link rel='alternate' hreflang='x-default' href={englishUrl} />}

<!-- THEME -->
<!-- The site follows `prefers-color-scheme` and has no toggle, so the browser chrome can be
     declared statically. `dark light` puts dark first: that is the palette a browser with no
     preference gets, matching the base @theme block in src/styles/global.css. Kept here rather
     than in CSS so it applies before the stylesheet lands. Starlight owns its own <head> and does
     not render this component; it sets the same thing itself from `data-theme`. -->
<meta name='color-scheme' content='dark light' />
<meta name='theme-color' content='#201b1a' media='(prefers-color-scheme: dark)' />
<meta name='theme-color' content='#faf6ef' media='(prefers-color-scheme: light)' />

<!-- OPEN GRAPH -->
<meta property='og:type' content='website' />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:url' content={url} />
<meta property='og:image' content={imageUrl} />
<meta property='og:locale' content={langOf(locale)} />
{
  alternates
    .filter((alt) => alt.locale !== locale)
    .map((alt) => <meta property='og:locale:alternate' content={alt.lang} />)
}

<!-- optional article OG -->
{publishedTime && <meta property='article:published_time' content={publishedTime} />}
{author && <meta property='article:author' content={author} />}

<!-- TWITTER -->
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={imageUrl} />

<!-- JSON-LD: `<` is escaped as \u003c (still valid JSON) so no string in the payload can close the
     inline script or open a comment. -->
{jsonLd && <script type='application/ld+json' set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

<!-- ANALYTICS -->
<!-- Here rather than in the three layouts so a new layout cannot forget it. Starlight does not
     render this component and gets Analytics.astro through its own Head override instead. -->
<Analytics />
