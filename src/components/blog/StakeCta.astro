---
// The call to action at the end of every post, in the site's primary CTA style (the coral pill with
// the hard offset shadow) inside the same card the footer's closing CTA uses. `data-blog-cta` is what
// Tracking.astro listens for.
import { getT } from '../../i18n/t.ts'

const { t } = getT('en', ['blog'])
---

<aside
  class='border-border bg-surface mt-12 flex flex-col items-start justify-between gap-4 rounded-[20px] border p-6 sm:flex-row sm:items-center sm:gap-8 sm:px-8 sm:py-7'
>
  <div class='flex flex-col gap-2'>
    <p class='font-fredoka text-text text-xl font-semibold sm:text-2xl'>{t('blog.cta.title')}</p>
    <p class='text-text-muted text-[15px] leading-[1.55]'>{t('blog.cta.body')}</p>
  </div>
  <a
    href='/stake/'
    data-blog-cta
    class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover shrink-0 rounded-full px-[30px] py-3.5 text-base font-semibold shadow-[0_6px_0_var(--color-accent-shadow)] transition-colors'
  >
    {t('blog.cta.button')}
  </a>
</aside>
