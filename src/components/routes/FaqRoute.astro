---
// The whole `/faq/` document, shared by the English and the `[locale]` route (spec §B).
import Layout from '../../layouts/LandingLayout.astro'
import FAQ from '../FAQ.astro'
import Header from '../SiteHeader.astro'
import Footer from '../SiteFooter.astro'
import Banner from '../Banner.astro'
import { localeOf } from '../../i18n/locale.ts'
import { getT } from '../../i18n/t.ts'
import { getProse } from '../../i18n/prose.ts'
import { faqSectionIndex } from '../faqSections.ts'
import { faqPageJsonLd } from '../pages/jsonLd.ts'

const locale = localeOf(Astro)
const { t } = getT(locale, ['seo'])
const title = t('seo.faq.title')
const description = t('seo.faq.description')

// FAQPage JSON-LD from the same prose FAQ.astro renders, in visible order: section order from
// faqSections.ts, then frontmatter `order` (specs/faq-restructure.md, "FAQPage JSON-LD").
const questions = (await getProse(locale, 'faq'))
  .filter((entry) => faqSectionIndex(entry.data.section) >= 0)
  .sort((a, b) => faqSectionIndex(a.data.section) - faqSectionIndex(b.data.section) || a.data.order - b.data.order)
  // The anchor is the prose file name, the same id FAQ.astro puts on the <details>.
  .map((entry) => ({
    question: entry.data.question ?? '',
    body: entry.body ?? '',
    anchor: entry.id.slice(entry.id.lastIndexOf('/') + 1),
  }))
const jsonLd = faqPageJsonLd(questions, { path: '/faq/', title, description, locale })
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Banner />

  <Header active='faq' />

  <main class=''>
    <FAQ />
  </main>

  <Footer />
</Layout>
