---
// The language dropdown (spec §J/§L). It lists `public` locales only and renders nothing at all
// until at least two are public, so exposing a language is a registry edit, not a code change.
// Plain <details>/<summary>: works without JavaScript and survives view transitions. Every entry is
// a real link to the same path in the other locale (localizedPath round-trips the prefix).
// The panel floats below the button, hanging from its inline start (footer) or, for the header `bar`
// instance, its inline end. `bar` also means
// the header is tight below sm, so a two-letter code replaces the painted name; the name stays in the
// accessibility tree at every width.
import { LOCALES, publicLocales } from '../i18n/registry.mjs'
import { langOf, localeCode, localeOf, localizedPath, stripLocale } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'

interface Props {
  bar?: boolean
  class?: string
}

const { bar = false, class: className } = Astro.props
const locale = localeOf(Astro)
const locales = publicLocales()
const show = locales.length >= 2

const { t } = getT(locale, ['site'])
const { path } = stripLocale(Astro.url.pathname)
const entries = locales.map((l) => ({
  locale: l,
  lang: langOf(l),
  label: LOCALES[l].label,
  href: localizedPath(path, l),
  current: l === locale,
}))
---

{
  show && (
    <details data-i18n-switcher class:list={['group relative', className]}>
      <summary
        class='hover:text-accent flex cursor-pointer list-none items-center gap-1.5 [&::-webkit-details-marker]:hidden'
        title={t('site.switcher.label')}
      >
        <span class='sr-only'>{t('site.switcher.label')}: </span>
        <svg class='size-4 shrink-0' fill='none' stroke='currentColor' stroke-width='1.8' viewBox='0 0 24 24'>
          <circle cx='12' cy='12' r='9' />
          <path stroke-linecap='round' d='M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18' />
        </svg>
        <span class:list={[bar && 'max-sm:sr-only']}>{LOCALES[locale].label}</span>
        {bar && (
          <span aria-hidden='true' class='sm:hidden'>
            {localeCode(locale)}
          </span>
        )}
        <svg
          class='size-3 shrink-0 transition-transform group-open:rotate-180'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          viewBox='0 0 24 24'
        >
          <path stroke-linecap='round' stroke-linejoin='round' d='m6 9 6 6 6-6' />
        </svg>
      </summary>
      <ul
        class:list={[
          'border-border bg-surface max-h-[min(60vh,22rem)] min-w-40 overflow-y-auto rounded-xl border py-1.5',
          'absolute top-full z-20 mt-2 shadow-lg',
          bar ? 'end-0' : 'start-0',
        ]}
      >
        {entries.map(({ locale: entry, lang, label, href, current }) => (
          <li>
            <a
              href={href}
              hreflang={lang}
              lang={lang}
              data-locale={entry}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'hover:bg-surface-deep hover:text-accent block px-4 py-2 text-sm',
                current ? 'text-accent' : 'text-text-muted',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  // Spec §J: remember the picked language — LOCALE_KEY so the one-time "Read this in …?" suggestion
  // (banner.js) never re-asks, PREF_KEY so a later visit lands in that language
  // (LocalePreference.astro). Delegated on the document, which the ClientRouter never swaps, so one
  // listener covers every switcher on every page: the site header and footer, the app shell's mirror
  // and — since they are the same `<details>` in the DOM — the React island's, which has no open
  // state of its own. The link navigates regardless of storage.
  //
  // The two keys are spelled out rather than imported from src/scripts/locale-keys.js, which is their
  // canonical home: an import makes Astro bundle this hoisted script into its own request instead of
  // inlining it, and closing the panel would then wait on that fetch on a cold load. Same reasoning as
  // the inline script in starlight/LanguageSelect.astro. Change them in both places.
  const LOCALE_KEY = 'hipo.locale'
  const PREF_KEY = 'hipo.locale.pref'

  // Close every open panel except the one the interaction is inside. Clicking a closed summary is
  // still inside its own <details>, so it opens normally; clicking a second switcher closes the
  // first; clicking anywhere else closes them all.
  function closeOutside(target: Element | null) {
    for (const details of document.querySelectorAll('[data-i18n-switcher][open]')) {
      if (target == null || !details.contains(target)) {
        details.removeAttribute('open')
      }
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null
    const link = target?.closest?.('[data-i18n-switcher] a[data-locale]')
    // The picked entry closes its own panel, so it never lingers open through the view transition,
    // or at all when the current language is picked.
    link?.closest('details')?.removeAttribute('open')
    const locale = link?.getAttribute('data-locale')
    if (locale != null) {
      try {
        localStorage.setItem(LOCALE_KEY, locale)
        localStorage.setItem(PREF_KEY, locale)
      } catch {
        // ignore
      }
    }
    closeOutside(target)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return
    }
    for (const details of document.querySelectorAll('[data-i18n-switcher][open]')) {
      details.removeAttribute('open')
      // Focus goes back to the control that opened the panel, or Escape would strand a keyboard
      // visitor at the top of the document.
      details.querySelector('summary')?.focus()
    }
  })

  // Tabbing out of the last entry closes it too.
  document.addEventListener('focusin', (event) => {
    closeOutside(event.target as Element | null)
  })
</script>
