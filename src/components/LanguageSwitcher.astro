---
// The language dropdown (spec §J/§L). It lists `public` locales only and renders nothing at all
// until at least two are public, so exposing a language is a registry edit, not a code change.
// Plain <details>/<summary>: works without JavaScript and survives view transitions. Every entry is
// a real link to the same path in the other locale (localizedPath round-trips the prefix) — except on
// an English-only page (`localized={false}`, the blog), which has no such path in another locale:
// there every OTHER-locale entry links to that locale's home page instead of a 404, while the page's
// own locale still points at the current page.
// The panel floats below the button, hanging from its inline start, or for the header `bar` instance
// (since 2026-11-14 the only one; the footer's was removed) from its inline end. `bar` also means
// the header is tight below sm, so a two-letter code replaces the painted name; the name stays in the
// accessibility tree at every width.
import { LOCALES, publicLocales } from '../i18n/registry.mjs'
import { langOf, localeCode, localeOf, localizedPath, stripLocale } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import LanguageSwitcherScript from './LanguageSwitcherScript.astro'

interface Props {
  bar?: boolean
  class?: string
  localized?: boolean
}

const { bar = false, class: className, localized = true } = Astro.props
const locale = localeOf(Astro)
const locales = publicLocales()
const show = locales.length >= 2

const { t } = getT(locale, ['site'])
const { path } = stripLocale(Astro.url.pathname)
const entries = locales.map((l) => ({
  locale: l,
  lang: langOf(l),
  label: LOCALES[l].label,
  // On an English-only page (localized={false}, the blog) every other locale has no translated
  // twin and goes to its home page instead — but the page's own locale still has this exact page,
  // so its own entry stays on the current path rather than falling back to home too.
  href: localizedPath(localized || l === locale ? path : '/', l),
  current: l === locale,
}))
---

{
  show && (
    <details data-i18n-switcher class:list={['group relative', className]}>
      <summary
        class='hover:text-accent flex cursor-pointer list-none items-center gap-1.5 [&::-webkit-details-marker]:hidden'
        title={t('site.switcher.label')}
      >
        <span class='sr-only'>{t('site.switcher.label')}: </span>
        <svg class='size-4 shrink-0' fill='none' stroke='currentColor' stroke-width='1.8' viewBox='0 0 24 24'>
          <circle cx='12' cy='12' r='9' />
          <path stroke-linecap='round' d='M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18' />
        </svg>
        <span class:list={[bar && 'max-sm:sr-only']}>{LOCALES[locale].label}</span>
        {bar && (
          <span aria-hidden='true' class='sm:hidden'>
            {localeCode(locale)}
          </span>
        )}
        <svg
          class='size-3 shrink-0 transition-transform group-open:rotate-180'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          viewBox='0 0 24 24'
        >
          <path stroke-linecap='round' stroke-linejoin='round' d='m6 9 6 6 6-6' />
        </svg>
      </summary>
      <ul
        class:list={[
          'border-border bg-surface max-h-[min(60vh,22rem)] min-w-40 overflow-y-auto rounded-xl border py-1.5',
          'absolute top-full z-20 mt-2 shadow-lg',
          bar ? 'end-0' : 'start-0',
        ]}
      >
        {entries.map(({ locale: entry, lang, label, href, current }) => (
          <li>
            <a
              href={href}
              hreflang={lang}
              lang={lang}
              data-locale={entry}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'hover:bg-surface-deep hover:text-accent block px-4 py-2 text-sm',
                current ? 'text-accent' : 'text-text-muted',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<LanguageSwitcherScript />
