---
// The one global header for every non-docs static page (home, FAQ, HPO, blog). The app pages render
// the same bar from React (src/components/app/Header.tsx) and its static first paint
// (src/components/app/shell/ShellHeader.astro) — keep the three in sync, items and classes.
// One flat list of four main items (Stake, the Club slot, Stats, HPO) is the inline nav from
// lg and the fixed bottom tab bar below lg, on every page; five items fit at 1024 px in every locale
// (measured 2026-11-02, Russian with Open app the widest), so four fit too. The hamburger exists only
// below lg and holds DeFi, Docs, FAQ, Blog and Open app. `active` colors the current page's item
// in coral. Home is the logo.
import { localeOf, localizedPath } from '../i18n/locale.ts'
import { DEFAULT_LOCALE } from '../i18n/registry.mjs'
import { getT } from '../i18n/t.ts'
import LanguageSwitcher from './LanguageSwitcher.astro'
import ShellIcon from './app/shell/ShellIcon.astro'
import { clubBuilt } from '../data/club-flag.mjs'

interface Props {
  active?: 'hpo' | 'faq'
  // Forwarded to the LanguageSwitcher; false on English-only pages (the blog).
  localized?: boolean
}

const { active, localized = true } = Astro.props
const locale = localeOf(Astro)
const { t } = getT(locale, ['site'])

const items = [
  { key: 'stake', href: '/stake/', label: t('site.nav.stake'), icon: 'coins' as const },
  // Rewards until the launch commit, the Club after it (src/data/club-flag.mjs).
  clubBuilt()
    ? { key: 'club', href: '/club/', label: t('site.nav.club'), icon: 'gift' as const }
    : { key: 'rewards', href: '/rewards/', label: t('site.nav.rewards'), icon: 'gift' as const },
  { key: 'stats', href: '/stats/', label: t('site.nav.stats'), icon: 'chart-line' as const },
  { key: 'hpo', href: '/hpo/', label: t('site.nav.hpo'), icon: 'hpo' as const },
].map((item) => ({ ...item, href: localizedPath(item.href, locale) }))

// The blog is English-only, so every other locale says so with hreflang (as SiteFooter does).
const secondary = [
  { key: 'defi', href: localizedPath('/defi/', locale), label: t('site.nav.defi'), hreflang: undefined },
  { key: 'docs', href: localizedPath('/docs/', locale), label: t('site.nav.docs'), hreflang: undefined },
  { key: 'faq', href: localizedPath('/faq/', locale), label: t('site.nav.faq'), hreflang: undefined },
  {
    key: 'blog',
    href: '/blog/',
    label: t('site.footer.blog'),
    hreflang: locale === DEFAULT_LOCALE ? undefined : 'en',
  },
]
---

<header>
  <script src='/src/scripts/landing-menu.js'></script>

  <div class='mx-auto flex w-full max-w-[1280px] items-center justify-between gap-4 px-6 py-5 md:px-12'>
    <a href={localizedPath('/', locale)} class='flex flex-none items-center gap-2.5'>
      <img src='/images/hipo.svg' alt='Hipo' class='logo-on-dark size-9' />
      <img src='/images/hipo-light.svg' alt='Hipo' class='logo-on-light size-9' />
      <span class='font-wordmark text-text text-2xl font-semibold'>Hipo</span>
    </a>

    <nav class='text-text-muted text-body hidden items-center gap-6 font-medium lg:flex'>
      {
        items.map(({ key, href, label }) => (
          <a href={href} class={key === active ? 'text-accent' : 'hover:text-accent'}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class='flex items-center gap-4'>
      <LanguageSwitcher bar localized={localized} />

      <a
        href={localizedPath('/stake/', locale)}
        class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover text-body hidden rounded-full px-6 py-[11px] font-semibold whitespace-nowrap lg:inline-block'
      >
        {t('site.cta.openApp')}
      </a>

      <button
        id='menu-button'
        class='text-text lg:hidden'
        title={t('site.header.menuToggle')}
        aria-label={t('site.header.menuToggle')}
      >
        <svg class='size-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16'></path>
        </svg>
      </button>
    </div>
  </div>

  <div id='mobile-menu' class='hidden px-6 pb-6 lg:hidden'>
    <nav class='text-text-muted text-body flex flex-col gap-1 font-medium'>
      {
        secondary.map(({ key, href, label, hreflang }) => (
          <a
            href={href}
            hreflang={hreflang}
            class={`hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5 ${key === active ? 'text-accent' : ''}`}
          >
            {label}
          </a>
        ))
      }
      <a
        href={localizedPath('/stake/', locale)}
        class='bg-accent-fill text-on-accent mt-2 rounded-full px-6 py-2.5 text-center font-semibold'
      >
        {t('site.cta.openApp')}
      </a>
    </nav>
  </div>

  <nav
    aria-label={t('site.header.mainNav')}
    class='border-border bg-surface-deep fixed start-0 end-0 bottom-0 z-10 flex w-full flex-row border-t select-none lg:hidden'
  >
    {
      items.map(({ key, href, label, icon }) => (
        <a
          href={href}
          aria-label={label}
          aria-current={key === active ? 'page' : undefined}
          class={
            'flex min-h-12 flex-1 cursor-pointer flex-col items-center justify-center gap-0.5 py-1.5 text-xs font-medium ' +
            (key === active ? 'text-accent' : 'text-text-muted hover:text-accent')
          }
        >
          <ShellIcon name={icon} class='size-[18px]' maskId='hpo-m-site' />
          <span set:text={label} />
        </a>
      ))
    }
  </nav>
</header>
