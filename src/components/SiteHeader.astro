---
// The one global header for every non-docs static page (home, FAQ, HPO). The app pages render
// the same bar from React (src/components/app/Header.tsx) so the wallet button can live in it —
// keep the nav items and classes in sync between the two. One flat menu carries every site and
// app destination, so the menu never changes between pages; `active` colors the current page's
// item in coral. Eight items need room, so the inline nav shows from lg and the hamburger
// covers everything below that.
import { localeOf, localizedPath } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  active?: 'home' | 'hpo' | 'faq'
}

const { active } = Astro.props
const locale = localeOf(Astro)
const { t } = getT(locale, ['site'])

const items = [
  { key: 'home', href: '/', label: t('site.nav.home') },
  { key: 'hpo', href: '/hpo/', label: t('site.nav.hpo') },
  { key: 'docs', href: '/docs/', label: t('site.nav.docs') },
  { key: 'faq', href: '/faq/', label: t('site.nav.faq') },
  { key: 'stake', href: '/stake/', label: t('site.nav.stake') },
  { key: 'rewards', href: '/rewards/', label: t('site.nav.rewards') },
  { key: 'stats', href: '/stats/', label: t('site.nav.stats') },
  { key: 'defi', href: '/defi/', label: t('site.nav.defi') },
].map((item) => ({ ...item, href: localizedPath(item.href, locale) }))
---

<header>
  <script src='/src/scripts/landing-menu.js'></script>

  <div class='mx-auto flex w-full max-w-[1280px] items-center justify-between px-6 py-5 md:px-12'>
    <a href={localizedPath('/', locale)} class='flex items-center gap-2.5'>
      <img src='/images/hipo.svg' alt='Hipo' class='logo-on-dark size-9' />
      <img src='/images/hipo-light.svg' alt='Hipo' class='logo-on-light size-9' />
      <span class='font-fredoka text-text text-2xl font-semibold'>Hipo</span>
    </a>

    <nav class='text-text-muted hidden items-center gap-6 text-[15px] font-medium lg:flex'>
      {
        items.map(({ key, href, label }) => (
          <a href={href} class={key === active ? 'text-accent' : 'hover:text-accent'}>
            {label}
          </a>
        ))
      }
      <LanguageSwitcher />
    </nav>

    <div class='flex items-center gap-4'>
      <a
        href={localizedPath('/stake/', locale)}
        class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover hidden rounded-full px-6 py-[11px] text-[15px] font-semibold lg:inline-block'
      >
        {t('site.cta.openApp')}
      </a>

      <button
        id='menu-button'
        class='text-text lg:hidden'
        title={t('site.header.menuToggle')}
        aria-label={t('site.header.menuToggle')}
      >
        <svg class='size-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16'></path>
        </svg>
      </button>
    </div>
  </div>

  <div id='mobile-menu' class='hidden px-6 pb-6 lg:hidden'>
    <nav class='text-text-muted flex flex-col gap-1 text-[15px] font-medium'>
      {
        items.map(({ key, href, label }) => (
          <a
            href={href}
            class={`hover:bg-surface hover:text-accent rounded-lg px-3 py-2.5 ${key === active ? 'text-accent' : ''}`}
          >
            {label}
          </a>
        ))
      }
      <a
        href={localizedPath('/stake/', locale)}
        class='bg-accent-fill text-on-accent mt-2 rounded-full px-6 py-2.5 text-center font-semibold'
      >
        {t('site.cta.openApp')}
      </a>
      <LanguageSwitcher inline class='mt-2 px-3 py-2.5' />
    </nav>
  </div>
</header>
