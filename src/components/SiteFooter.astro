---
// The one site-wide footer (home, FAQ, HPO, and the app pages). Replaces the three per-section
// footers so every page ends the same way. `app` adds the bottom padding that keeps the footer
// clear of the app's fixed mobile tab bar.
import { DEFAULT_LOCALE } from '../i18n/registry.mjs'
import { localeOf, localizedPath } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  app?: boolean
  // Forwarded to the LanguageSwitcher; false on English-only pages (the blog).
  localized?: boolean
  // False hides the closing CTA card below, same as `app` — a blog post already ends with its own
  // tracked CTA (StakeCta.astro), so BlogLayout passes this false there; the blog index keeps it.
  cta?: boolean
}

const { app = false, localized = true, cta = true } = Astro.props
const locale = localeOf(Astro)
const { t } = getT(locale, ['site'])

const socialLinks = [
  { href: 'https://t.me/HipoFinance', label: t('site.footer.telegramChannel') },
  { href: 'https://t.me/hipo_chat', label: t('site.footer.telegramChat') },
  { href: 'https://x.com/hipofinance', label: 'X' },
  { href: 'https://www.youtube.com/@HipoFinance', label: 'YouTube' },
  // The blog is English-only (specs/blog-migration.md), so every locale links the one /blog/ and says
  // so with hreflang; it opens in the same tab like the other on-site links.
  {
    href: '/blog/',
    label: t('site.footer.blog'),
    external: false,
    hreflang: locale === DEFAULT_LOCALE ? undefined : 'en',
  },
]

const docsLinks = [
  { href: 'https://github.com/HipoFinance', label: 'GitHub', external: true },
  { href: localizedPath('/docs/', locale), label: t('site.footer.documentation'), external: false },
  { href: localizedPath('/hpo/', locale), label: t('site.footer.aboutHpo'), external: false },
  { href: localizedPath('/stats/', locale), label: t('site.footer.stats'), external: false },
  // /vs/ had no static link anywhere before this (specs/search-console-coverage-sitemaps.md).
  { href: localizedPath('/vs/', locale), label: t('site.footer.compare'), external: false },
  { href: localizedPath('/faq/', locale), label: t('site.footer.faq'), external: false },
  // The link has to be on every page — /verify/ only helps someone who was just sent a suspicious
  // message, and they reach it by navigating, not by already having a link. Localized since
  // 2026-09-01: that reader is in a hurry and reads the warning in their own language.
  { href: localizedPath('/verify/', locale), label: t('site.footer.verify'), external: false },
  { href: 'https://t.me/hipo_chat', label: t('site.footer.helpSupport'), external: true },
]
---

<footer class:list={['font-body bg-surface-deep text-text-faint mt-auto', app && 'pb-20 lg:pb-0']}>
  <div class='mx-auto w-full max-w-[1120px] px-6 py-10 sm:px-10'>
    {
      /* The closing CTA, in place of the old "Join Hipo on Telegram" strip: that strip duplicated the
         home page's Hipo Community section, and both Telegram links survive in the Social column
         below. Suppressed on the app pages — "start staking" is noise at the bottom of the staking
         app itself. Also suppressed on a blog post page via `cta`, for the same reason: its own
         StakeCta.astro already closes the post. */
    }
    {
      !app && cta && (
        <div
          class='border-border mb-10 flex flex-col items-start justify-between gap-4 rounded-[20px] border p-6 sm:flex-row sm:items-center sm:gap-8 sm:px-8 sm:py-7'
          style='background: linear-gradient(120deg, rgba(255,126,115,.12), rgba(255,126,115,0) 60%);'
        >
          <div class='flex flex-col gap-2'>
            <div class='font-fredoka text-text text-xl font-semibold sm:text-2xl'>{t('site.footer.ctaTitle')}</div>
            <p class='text-text-muted text-[15px] leading-[1.55]'>{t('site.footer.ctaBody')}</p>
          </div>
          <a
            class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover shrink-0 rounded-full px-[30px] py-3.5 text-base font-semibold shadow-[0_6px_0_var(--color-accent-shadow)] transition-colors'
            href={localizedPath('/stake/', locale)}
          >
            {t('site.footer.ctaButton')}
          </a>
        </div>
      )
    }

    <div class='flex flex-col gap-10 sm:flex-row sm:justify-between'>
      <div class='max-w-sm'>
        <div class='text-text flex flex-row items-center gap-2.5'>
          <img src='/images/hipo.svg' alt='' class='logo-on-dark size-9' />
          <img src='/images/hipo-light.svg' alt='' class='logo-on-light size-9' />
          <p class='font-fredoka text-2xl font-semibold'>Hipo</p>
        </div>
        <p class='mt-3 text-sm'>{t('site.footer.tagline')}</p>
        <LanguageSwitcher class='mt-4 w-fit text-sm' localized={localized} />
      </div>

      <div class='flex flex-row flex-wrap gap-x-16 gap-y-8'>
        <div>
          <h3 class='text-text-muted text-sm font-medium'>{t('site.footer.social')}</h3>
          {
            socialLinks.map(({ href, label, external = true, hreflang }) => (
              <a
                class='hover:text-accent mt-3 block text-sm'
                href={href}
                hreflang={hreflang}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            ))
          }
        </div>

        <div>
          <h3 class='text-text-muted text-sm font-medium'>{t('site.footer.docs')}</h3>
          {
            docsLinks.map(({ href, label, external }) => (
              <a
                class='hover:text-accent mt-3 block text-sm'
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</footer>
