<script src='/src/scripts/banner.js'></script>

<div id='site-banner' class='bg-accent text-on-accent hidden'>
  <div
    class='relative mx-auto flex max-w-[1280px] items-center justify-center gap-2 px-12 py-2.5 text-center text-[15px] font-medium'
  >
    <span>
      💰 <strong class='font-semibold'>Earn 100% of staking rewards.</strong> Staking fee is now 0%.
      <a href='/stake/' class='font-bold underline underline-offset-2'>Earn now</a>
    </span>
    <button
      id='close-banner'
      class='text-on-accent/70 hover:text-on-accent absolute top-1/2 right-3 -translate-y-1/2 p-2'
      aria-label='Dismiss banner'
    >
      ✕
    </button>
  </div>
</div>
