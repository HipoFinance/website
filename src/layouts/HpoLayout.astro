---
import '../styles/global.css'
import SEO from '../components/SEO.astro'
import { dirOf, langOf, localeOf, localizedPath } from '../i18n/locale.ts'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const locale = localeOf(Astro)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: title,
  url: new URL(localizedPath('/hpo/', locale), Astro.site).href,
  description,
  inLanguage: langOf(locale),
  publisher: {
    '@type': 'Organization',
    name: 'Hipo',
    logo: {
      '@type': 'ImageObject',
      url: 'https://hipo.finance/hipo.svg',
    },
  },
}
---

<!doctype html>
<html lang={langOf(locale)} dir={dirOf(locale)} class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />

    <SEO title={title} description={description} jsonLd={jsonLd} />

    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <body class='bg-bg font-heebo text-text flex min-h-screen flex-col'>
    <slot />
  </body>
</html>
