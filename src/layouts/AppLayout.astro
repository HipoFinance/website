---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '../styles/app.css'
import SEO from '../components/SEO.astro'
import AppIsland from '../components/app/AppIsland.tsx'
import SiteFooter from '../components/SiteFooter.astro'
import Banner from '../components/Banner.astro'

interface Props {
  title: string
  description: string
  jsonLd?: Record<string, any>
}

const {
  title,
  description,
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    url: Astro.url.href,
    description,
    publisher: {
      '@type': 'Organization',
      name: 'Hipo',
      logo: {
        '@type': 'ImageObject',
        url: 'https://hipo.finance/hipo.svg',
      },
    },
  },
} = Astro.props
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />

    <SEO title={title} description={description} jsonLd={jsonLd} />

    <ClientRouter />

    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />

    <meta name='theme-color' content='#201b1a' />
    <meta name='color-scheme' content='dark' />

    <!-- Telegram Mini App: marks <html> before the first paint so the static shell below never
         flashes inside Telegram while the island loads. This is a deliberate duplicate of
         probeTmaMode() in src/components/app/tma/telegram.ts — keep the two in sync; the island
         reads window.__hipoTma and only re-probes if this script did not run. Nothing else here
         depends on Telegram: outside it the script sets 'off' and stops. -->
    <script is:inline>
      ;(function () {
        var mode = 'off'
        try {
          var override = new URLSearchParams(window.location.search).get('tma')
          var remembered = window.sessionStorage.getItem('hipo.tma')
          var initParams = window.sessionStorage.getItem('__telegram__initParams')
          if (override === '1') {
            window.sessionStorage.setItem('hipo.tma', 'forced')
            mode = 'forced'
          } else if (override === '0') {
            window.sessionStorage.removeItem('hipo.tma')
          } else if (remembered === 'forced' || remembered === 'telegram') {
            mode = remembered
          } else if (
            window.location.hash.indexOf('tgWebAppPlatform=') >= 0 ||
            window.location.hash.indexOf('tgWebAppData=') >= 0 ||
            (initParams !== null && initParams.indexOf('tgWebAppPlatform') >= 0)
          ) {
            mode = 'telegram'
          }
        } catch (e) {
          mode = 'off'
        }
        window.__hipoTma = mode
        if (mode !== 'off') {
          document.documentElement.classList.add('tma')
        }
      })()
    </script>
  </head>

  <!-- Single warm-dark theme: no toggle and no theme bootstrap script anymore, so nothing here
       depends on the `.dark` class. -->
  <body class='bg-bg text-text font-body'>
    <script async src='https://tganalytics.xyz/index.js' type='text/javascript' is:inline></script>
    <script>
      window.addEventListener('load', function () {
        if (location.host === 'hipo.finance' && window.telegramAnalytics) {
          window.telegramAnalytics.init({
            token:
              'eyJhcHBfbmFtZSI6IkhpcG9GaW5hbmNlIiwiYXBwX3VybCI6Imh0dHBzOi8vdC5tZS9IaXBvRmluYW5jZUJvdCIsImFwcF9kb21haW4iOiJodHRwczovL2FwcC5oaXBvLmZpbmFuY2UifQ==!E4pxUC4Gw7gYJ/OLjvBnyB3xdqnfZd96quHuM0hwQEY=',
            appName: 'HipoFinance',
          })
        }
      })
    </script>

    <div data-tma-hide><Banner /></div>

    <main>
      <AppIsland client:only='react' transition:persist='app-island' />
      <!-- Removed by App.tsx the moment the island hydrates (and again after every ClientRouter
           swap). On slow connections this is what tells the user an app is coming, instead of the
           bare SEO copy below reading as the whole page. -->
      <div data-app-loading class='flex min-h-[55vh] flex-col items-center justify-center gap-4'>
        <div class='border-border border-t-accent size-10 animate-spin rounded-full border-4'></div>
        <p class='text-text-muted font-body text-sm'>Loading the Hipo app…</p>
      </div>
    </main>

    <!-- data-tma-hide: the three wrappers below are the static shell around the island. They are
         hidden wholesale in Telegram Mini App mode (see .tma rules in src/styles/app.css); the
         attribute is the only hook that CSS needs, and it does nothing outside that mode. -->
    <div data-tma-hide><slot /></div>

    <nav
      aria-label='Hipo app pages'
      class='font-body text-text-faint mx-auto w-full max-w-3xl px-4 pb-12 text-[13px] max-lg:pb-28'
      data-tma-hide
    >
      <ul class='flex flex-wrap justify-center gap-x-6 gap-y-2'>
        <li><a class='hover:text-accent' href='/stake/'>Stake</a></li>
        <li><a class='hover:text-accent' href='/unstake/'>Unstake</a></li>
        <li><a class='hover:text-accent' href='/rewards/'>Rewards</a></li>
        <li><a class='hover:text-accent' href='/stats/'>Stats</a></li>
        <li><a class='hover:text-accent' href='/defi/'>DeFi</a></li>
        <li><a class='hover:text-accent' href='/docs/'>Docs</a></li>
      </ul>
    </nav>

    <div data-tma-hide><SiteFooter app /></div>
  </body>
</html>
