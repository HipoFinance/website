---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '../styles/app.css'
import SEO from '../components/SEO.astro'
import AppIsland from '../components/app/AppIsland.tsx'
import AppFooter from '../components/AppFooter.astro'

interface Props {
  title: string
  description: string
  jsonLd?: Record<string, any>
}

const {
  title,
  description,
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    url: Astro.url.href,
    description,
    publisher: {
      '@type': 'Organization',
      name: 'Hipo',
      logo: {
        '@type': 'ImageObject',
        url: 'https://hipo.finance/hipo.svg',
      },
    },
  },
} = Astro.props
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />

    <SEO title={title} description={description} jsonLd={jsonLd} />

    <ClientRouter />

    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />

    <meta name='theme-color' content='#201b1a' />
    <meta name='color-scheme' content='dark' />
  </head>

  <!-- Single warm-dark theme: no toggle and no theme bootstrap script anymore, so nothing here
       depends on the `.dark` class. -->
  <body class='bg-bg text-text font-body'>
    <script async src='https://tganalytics.xyz/index.js' type='text/javascript' is:inline></script>
    <script>
      window.addEventListener('load', function () {
        if (location.host === 'hipo.finance' && window.telegramAnalytics) {
          window.telegramAnalytics.init({
            token:
              'eyJhcHBfbmFtZSI6IkhpcG9GaW5hbmNlIiwiYXBwX3VybCI6Imh0dHBzOi8vdC5tZS9IaXBvRmluYW5jZUJvdCIsImFwcF9kb21haW4iOiJodHRwczovL2FwcC5oaXBvLmZpbmFuY2UifQ==!E4pxUC4Gw7gYJ/OLjvBnyB3xdqnfZd96quHuM0hwQEY=',
            appName: 'HipoFinance',
          })
        }
      })
    </script>

    <main>
      <AppIsland client:only='react' transition:persist='app-island' />
    </main>

    <slot />

    <nav
      aria-label='Hipo app pages'
      class='font-body text-text-faint mx-auto w-full max-w-3xl px-4 pb-12 text-[13px] max-sm:pb-28'
    >
      <ul class='flex flex-wrap justify-center gap-x-6 gap-y-2'>
        <li><a class='hover:text-accent' href='/stake/'>Stake</a></li>
        <li><a class='hover:text-accent' href='/unstake/'>Unstake</a></li>
        <li><a class='hover:text-accent' href='/rewards/'>Rewards</a></li>
        <li><a class='hover:text-accent' href='/stats/'>Stats</a></li>
        <li><a class='hover:text-accent' href='/defi/'>DeFi</a></li>
        <li><a class='hover:text-accent' href='/docs/'>Docs</a></li>
      </ul>
    </nav>

    <AppFooter />
  </body>
</html>
