---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '../styles/app.css'
import SEO from '../components/SEO.astro'
import AppIsland from '../components/app/AppIsland.tsx'
import SiteFooter from '../components/SiteFooter.astro'
import LanguageSwitcherScript from '../components/LanguageSwitcherScript.astro'
import Banner from '../components/Banner.astro'
import AppShell from '../components/app/shell/AppShell.astro'
import type { ShellPage } from '../components/pages/shellJsonLd'
import { dirOf, langOf, localeOf, localizedPath, stripLocale } from '../i18n/locale.ts'
import { getAppCatalog, getClubCatalog, getT } from '../i18n/t.ts'
import { appStats, fetchGauge, statsCards } from '../data/gauge.ts'
import { fetchStatsSeed } from '../data/stats.ts'
import { clubBuilt } from '../data/club-flag.mjs'

interface Props {
  title: string
  description: string
  page: ShellPage
  jsonLd?: Record<string, any>
}

const locale = localeOf(Astro)
const { t } = getT(locale, ['site'])

// The same page's canonical URL in this locale (the request path re-prefixed through localizedPath, like
// the landing/HPO layouts do), so the JSON-LD never carries a dev-server origin.
const { path: pagePath } = stripLocale(Astro.url.pathname)

const {
  title,
  description,
  page,
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    url: new URL(localizedPath(pagePath, locale), Astro.site).href,
    description,
    inLanguage: langOf(locale),
    publisher: {
      '@type': 'Organization',
      name: 'Hipo',
      logo: {
        '@type': 'ImageObject',
        url: 'https://hipo.finance/hipo.svg',
      },
    },
  },
} = Astro.props

// i18n (spec §D): the island reads its catalog from the #i18n-app JSON tag below; English is bundled in
// the island, so the tag is emitted for other locales only. `<` is escaped so no catalog value can close
// the script element.
const appCatalogJson = locale === 'en' ? undefined : JSON.stringify(getAppCatalog(locale)).replace(/</g, '\\u003c')
// The Club's own catalog, on Club pages only (the island bundles the English one in its Club chunk).
const clubCatalogJson =
  page === 'club' && locale !== 'en' ? JSON.stringify(getClubCatalog(locale)).replace(/</g, '\\u003c') : undefined

// Live protocol figures, fetched once per build (src/data/gauge.ts). They are rendered into the
// static shell below AND inlined as JSON so the island can seed itself from the same payload —
// that is what stops the numbers blinking when React mounts. Escaped like the catalog above so no
// value can close the script element. Absent when the gauge was unreachable at build time, in
// which case the shell shows dashes and the island's own fetch fills them in as before.
const gauge = await fetchGauge()
const gaugeJson = gauge === undefined ? undefined : JSON.stringify(gauge).replace(/</g, '\\u003c')
const stats = appStats(locale, gauge)

// The Stats page needs two figures the gauge does not carry — the hGRAM/GRAM rate and the three
// "over 1M" deltas — so /stats/ additionally fetches a compact Prometheus seed at build time and
// inlines it. Only that page: the other four have no card that reads it, and the seed is fetched
// once per build regardless of how many pages ask.
const seed = page === 'stats' ? await fetchStatsSeed() : undefined
const seedJson = seed === undefined ? undefined : JSON.stringify(seed).replace(/</g, '\\u003c')
const cards = page === 'stats' ? statsCards(locale, gauge, seed?.rate) : {}

// Footer nav under the shell copy. /docs/ goes through localizedPath like every other internal link (the
// SiteFooter's Documentation link already does); docs get their per-locale routes in phase 4, and until
// then no non-English locale is public, so nobody can reach a missing /<locale>/docs/.
const footerNav = [
  { href: '/stake/', label: t('site.app.nav.stake') },
  { href: '/unstake/', label: t('site.app.nav.unstake') },
  clubBuilt()
    ? { href: '/club/', label: t('site.app.nav.club') }
    : { href: '/rewards/', label: t('site.app.nav.rewards') },
  { href: '/stats/', label: t('site.app.nav.stats') },
  { href: '/defi/', label: t('site.app.nav.defi') },
  { href: '/docs/', label: t('site.app.nav.docs') },
].map(({ href, label }) => ({ href: localizedPath(href, locale), label }))
---

<!doctype html>
<html lang={langOf(locale)} dir={dirOf(locale)} class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />

    <!-- Telegram Mini App: marks <html> before the first paint so the static shell below never
         flashes inside Telegram while the island loads. Must stay ABOVE <SEO>, which renders
         Analytics.astro: that script reads window.__hipoTma to tag hits as mini-app or web. This is a deliberate duplicate of
         probeTmaMode() in src/components/app/tma/telegram.ts — keep the two in sync; the island
         reads window.__hipoTma and only re-probes if this script did not run. Nothing else here
         depends on Telegram: outside it the script sets 'off' and stops. -->
    <script is:inline>
      ;(function () {
        var mode = 'off'
        try {
          var override = new URLSearchParams(window.location.search).get('tma')
          var remembered = window.sessionStorage.getItem('hipo.tma')
          var initParams = window.sessionStorage.getItem('__telegram__initParams')
          if (override === '1') {
            window.sessionStorage.setItem('hipo.tma', 'forced')
            mode = 'forced'
          } else if (override === '0') {
            window.sessionStorage.removeItem('hipo.tma')
          } else if (remembered === 'forced' || remembered === 'telegram') {
            mode = remembered
          } else if (
            window.location.hash.indexOf('tgWebAppPlatform=') >= 0 ||
            window.location.hash.indexOf('tgWebAppData=') >= 0 ||
            (initParams !== null && initParams.indexOf('tgWebAppPlatform') >= 0)
          ) {
            mode = 'telegram'
          }
        } catch (e) {
          mode = 'off'
        }
        window.__hipoTma = mode
        if (mode !== 'off') {
          document.documentElement.classList.add('tma')
        }
      })()
    </script>

    <!-- Stale page: a deploy deletes the old hashed /_astro/ files, so a cached or long-open page can
         no longer load the app. This is inline because it must work when every app file is gone. It
         reloads once a minute at most (the sessionStorage guard), so a server that is really broken
         cannot cause a reload loop; then it shows #app-load-failed instead. -->
    <script is:inline>
      ;(function () {
        if (window.__hipoStaleReload) return
        window.__hipoStaleReload = true
        var KEY = 'hipo.staleReload'
        var reloading = false
        // Reloads only once the server has answered with the page, so an offline member or a failing
        // server keeps the page they have (and gets the notice) instead of the browser's error page.
        function freshReload() {
          if (reloading) return
          reloading = true
          var done = false
          function finish(ok) {
            if (done) return
            done = true
            if (ok) {
              location.reload()
            } else {
              reloading = false
              showNotice()
            }
          }
          setTimeout(function () {
            finish(false)
          }, 5000)
          try {
            fetch(location.href, { cache: 'reload' }).then(
              function (response) {
                finish(response.ok)
              },
              function () {
                finish(false)
              },
            )
          } catch (e) {
            finish(false)
          }
        }
        function showNotice() {
          var el = document.getElementById('app-load-failed')
          if (el) {
            el.hidden = false
          } else {
            document.addEventListener('DOMContentLoaded', showNotice)
          }
        }
        function onFailure() {
          // A reload is already on its way, or the member is offline: a failed load then is no sign
          // of a deploy, and the page they have stays as it is.
          if (reloading || navigator.onLine === false) return
          var recent = true
          try {
            var last = Number(window.sessionStorage.getItem(KEY))
            recent = last > 0 && Date.now() - last < 60000
            if (!recent) window.sessionStorage.setItem(KEY, String(Date.now()))
          } catch (e) {
            recent = true
          }
          if (recent) showNotice()
          else freshReload()
        }
        document.addEventListener('astro:hydration-error', function (event) {
          if (event.detail && event.detail.componentUrl) onFailure()
        })
        window.addEventListener('vite:preloadError', onFailure)
        document.addEventListener('click', function (event) {
          if (event.target && event.target.closest && event.target.closest('[data-app-reload]')) freshReload()
        })
      })()
    </script>

    <SEO title={title} description={description} jsonLd={jsonLd} />

    <ClientRouter />

    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <!-- Both palettes come from `prefers-color-scheme` alone (src/styles/global.css), so there is
       still no toggle and no theme bootstrap script — nothing here depends on a class. -->
  <body class='bg-bg text-text font-body'>
    <div data-tma-hide><Banner /></div>

    <main>
      <!-- Shown by the inline script in <head> when the app's files are gone and a reload was already
           tried. Outside data-tma-hide so it also shows in Telegram. The display classes are on the
           inner element, so the hidden attribute on the outer one really hides it. -->
      <div id='app-load-failed' role='alert' hidden>
        <div class='font-body text-text flex flex-col items-center gap-4 px-4 py-10 text-center'>
          <p>{t('site.app.loadFailed')}</p>
          <button
            type='button'
            data-app-reload
            class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover min-h-11 cursor-pointer rounded-full px-5 py-2.5 text-sm font-semibold'
          >
            {t('site.app.reload')}
          </button>
        </div>
      </div>
      {
        /* The island's catalog for this locale (see Model.syncLocale); absent for English. Lives in the
           static shell, so a ClientRouter swap between locales hands the persisted island its new
           catalog with no request. */
        appCatalogJson && <script type='application/json' id='i18n-app' set:html={appCatalogJson} />
      }
      {clubCatalogJson && <script type='application/json' id='i18n-club' set:html={clubCatalogJson} />}
      {
        /* The gauge payload the island seeds itself from (Model.readInlineGauge). Kept next to the
           catalog tag, inside the static shell, so a ClientRouter swap hands the persisted island a
           fresh copy without a request. */
        gaugeJson && <script type='application/json' id='gauge-data' set:html={gaugeJson} />
      }
      {
        /* The Stats page's rate/delta seed (Model.readInlineStats), emitted on /stats/ only. */
        seedJson && <script type='application/json' id='stats-data' set:html={seedJson} />
      }
      <AppIsland client:only='react' transition:persist='app-island' />
      <!-- The app's chrome, painted before the island arrives so the page does not go from a
           spinner to a full layout. App.tsx removes everything marked data-app-loading the moment
           it hydrates (and again after every ClientRouter swap). data-tma-hide because this is the
           desktop chrome: inside Telegram the island renders TmaApp instead, and the inline script
           in <head> has already set html.tma so this never paints there. -->
      <div data-app-loading data-tma-hide>
        <AppShell locale={locale} page={page} stats={stats} cards={cards} seed={seed} />
      </div>
    </main>

    <!-- data-tma-hide: the three wrappers below are the static shell around the island. They are
         hidden wholesale in Telegram Mini App mode (see .tma rules in src/styles/app.css); the
         attribute is the only hook that CSS needs, and it does nothing outside that mode. -->
    <div data-tma-hide><slot /></div>

    <nav
      aria-label={t('site.app.pagesNav')}
      class='font-body text-text-faint text-label mx-auto w-full max-w-3xl px-4 pb-12 max-lg:pb-28'
      data-tma-hide
    >
      <ul class='flex flex-wrap justify-center gap-x-6 gap-y-2'>
        {
          footerNav.map(({ href, label }) => (
            <li>
              <a class='hover:text-accent' href={href} set:text={label} />
            </li>
          ))
        }
      </ul>
    </nav>

    <div data-tma-hide><SiteFooter app /></div>
    <!-- Remembers a language picked in the shell's or the island's switcher, and closes their panel on an
         outside click or Escape (LanguageSwitcherScript.astro). -->
    <LanguageSwitcherScript />
  </body>
</html>
