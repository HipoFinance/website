---
import '../styles/global.css'
import SEO from '../components/SEO.astro'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: { title },
  url: 'https://hipo.finance',
  description: { description },
  publisher: {
    '@type': 'Organization',
    name: 'Hipo',
    logo: {
      '@type': 'ImageObject',
      url: 'https://hipo.finance/hipo.svg',
    },
  },
}
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />

    <SEO title={title} description={description} jsonLd={jsonLd} />

    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <body class='bg-bg font-body text-text'>
    <slot />
  </body>
</html>

<style is:global>
  /* The fill coral, not the foreground one: the selection band is a background with
     --color-on-accent text on it, so it stays brand coral in both schemes. */
  ::selection {
    background: var(--color-accent-fill);
    color: var(--color-on-accent);
  }
</style>
