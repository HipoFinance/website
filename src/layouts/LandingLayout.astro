---
import '../styles/global.css'
import SEO from '../components/SEO.astro'
import { dirOf, langOf, localeOf, localizedPath } from '../i18n/locale.ts'

interface Props {
  title: string
  description: string
  jsonLd?: Record<string, any>
  // Forwarded to SEO.astro; false on the English-only pages that have no `[locale]` twin.
  localized?: boolean
}

const locale = localeOf(Astro)

// A route may pass its own structured data (e.g. the FAQPage graph on /faq/); the default is the
// WebSite node every page carried before, same pattern as AppLayout.
const {
  title,
  description,
  localized = true,
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    url: new URL(localizedPath('/', locale), Astro.site).href,
    description,
    inLanguage: langOf(locale),
    publisher: {
      '@type': 'Organization',
      name: 'Hipo',
      logo: {
        '@type': 'ImageObject',
        url: 'https://hipo.finance/hipo.svg',
      },
    },
  },
} = Astro.props
---

<!doctype html>
<html lang={langOf(locale)} dir={dirOf(locale)} class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />

    <SEO title={title} description={description} jsonLd={jsonLd} localized={localized} />

    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <body class='bg-bg font-body text-text'>
    <slot />
  </body>
</html>

<style is:global>
  /* The fill coral, not the foreground one: the selection band is a background with
     --color-on-accent text on it, so it stays brand coral in both schemes. */
  ::selection {
    background: var(--color-accent-fill);
    color: var(--color-on-accent);
  }
</style>
