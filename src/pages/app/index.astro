---
// Legacy entry point. The app used to live entirely at /app/ with its sections and tabs encoded
// in the URL hash (#/page=<stake|reward|stats|defi>/tab=<stake|unstake>). It now lives at
// path-based pages (/stake/, /unstake/, /rewards/, /stats/, /defi/); this stub parses the old
// hash format and redirects. Deliberately not built on AppLayout/LandingLayout: it renders once,
// client-side only, and must stay tiny and noindex.
import '../../styles/global.css'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>Redirecting… | Hipo</title>
    <meta name='robots' content='noindex' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
  </head>

  <body class='bg-bg text-text flex min-h-screen flex-col items-center justify-center gap-4 text-center'>
    <p>Redirecting…</p>
    <p><a class='text-accent hover:text-accent-hover underline' href='/stake/'>Continue to the Hipo app</a></p>

    <script is:inline>
      ;(() => {
        var hash = location.hash.replace(/^#\/?/, '')
        var segments = hash.split('/').filter(Boolean)
        var page = null
        var tab = null

        segments.forEach(function (segment) {
          var pageMatch = segment.match(/^page=(.+)$/)
          var tabMatch = segment.match(/^tab=(.+)$/)
          if (pageMatch) page = pageMatch[1]
          if (tabMatch) tab = tabMatch[1]
          // network=... segments are intentionally ignored; testnet support is removed.
        })

        var target = '/stake/'
        if (page === 'reward') target = '/rewards/'
        else if (page === 'stats') target = '/stats/'
        else if (page === 'defi') target = '/defi/'
        else if (tab === 'unstake') target = '/unstake/'

        location.replace(target)
      })()
    </script>
  </body>
</html>
