---
import Layout from '../../layouts/AppLayout.astro'

const title = 'hGRAM in DeFi | Hipo'
const description =
  'Use hGRAM across TON DeFi: swap it on DEXs, provide liquidity, or hold it in wallets that support hGRAM and HPO.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: title,
      description,
      url: 'https://hipo.finance/defi/',
      isPartOf: { '@type': 'WebSite', name: 'Hipo', url: 'https://hipo.finance/' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Does using hGRAM in DeFi stop it from earning staking rewards?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Staking rewards keep accruing in the hGRAM exchange rate regardless of where you hold or use the token.',
          },
        },
        {
          '@type': 'Question',
          name: 'What are the risks of using hGRAM in DeFi?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'DeFi use adds smart-contract, liquidity, and price-impact risk on top of ordinary staking risk. Only use official, audited protocols and verify links before connecting a wallet.',
          },
        },
      ],
    },
  ],
}
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class='font-body text-brown dark:text-dark-50 mx-auto w-full max-w-3xl px-4 pt-8 pb-24'>
    <h1 class='mb-6 text-center text-3xl font-bold'>hGRAM in TON DeFi</h1>

    <div class='dark:bg-dark-800 mb-6 rounded-2xl bg-white p-6 shadow-sm'>
      <h2 class='mb-2 text-xl font-bold'>A DeFi-compatible token</h2>
      <p class='leading-relaxed'>
        hGRAM is a regular token on TON, so it isn't locked to Hipo the way a staked balance normally would be. You can
        hold it, transfer it, or put it to work in DeFi while it keeps earning staking rewards through its exchange rate
        against GRAM. The app above lists integrations Hipo currently points to; availability and terms depend on each
        third-party protocol.
      </p>
    </div>

    <div class='dark:bg-dark-800 mb-6 rounded-2xl bg-white p-6 shadow-sm'>
      <h2 class='mb-2 text-xl font-bold'>Swap hGRAM on DEXs</h2>
      <p class='leading-relaxed'>
        Trade hGRAM for other TON assets on decentralized exchanges such as DeDust, STON.fi, and TONCO. This is a quick
        way to exit hGRAM without going through Hipo's unstake flow, subject to pool liquidity, fees, and price impact.
      </p>
    </div>

    <div class='dark:bg-dark-800 mb-6 rounded-2xl bg-white p-6 shadow-sm'>
      <h2 class='mb-2 text-xl font-bold'>Provide liquidity</h2>
      <p class='leading-relaxed'>
        The same DEXs let you supply hGRAM to liquidity pools, earning a share of trading fees on top of the staking
        rewards already accruing in hGRAM's value.
      </p>
    </div>

    <div class='dark:bg-dark-800 rounded-2xl bg-white p-6 shadow-sm'>
      <h2 class='mb-2 text-xl font-bold'>Wallets with hGRAM and HPO support</h2>
      <p class='leading-relaxed'>
        Partner wallets such as TON Space and MyTonWallet support holding and moving hGRAM and HPO directly. See more
        use cases in the
        <a class='text-blue underline' href='/docs/hipo-tokens/hipo-staked-gram-hgram/hgram-use-cases/'>docs</a>.
      </p>
    </div>
  </section>
</Layout>
