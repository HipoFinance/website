---
// The Club (specs/club-website.md §1): /club/ (Overview), /club/rewards/, /club/friends/ and
// /club/community/. Behind the Club flag: with it off, getStaticPaths returns nothing and no /club/
// URL exists in the build.
import ShellRoute from '../../components/routes/ShellRoute.astro'
import { clubBuilt } from '../../data/club-flag.mjs'

export function getStaticPaths() {
  if (!clubBuilt()) {
    return []
  }
  return [undefined, 'rewards', 'friends', 'community'].map((tab) => ({ params: { tab } }))
}

const tab = (Astro.params.tab ?? 'overview') as 'overview' | 'rewards' | 'friends' | 'community'
---

<ShellRoute page='club' clubTab={tab} />
