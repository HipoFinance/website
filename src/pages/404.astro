---
import '../styles/global.css'
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <title>Page not found | Hipo</title>
    <meta name='robots' content='noindex' />
    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <body class='bg-bg font-body text-text flex min-h-screen items-center justify-center px-6'>
    <div class='w-full max-w-sm text-center'>
      <div class='font-fredoka text-accent text-6xl font-semibold'>404</div>

      <h1 class='font-fredoka text-text mt-4 text-xl font-semibold'>Page not found</h1>

      <p class='text-text-muted mt-2 text-[15px]'>The page you're looking for doesn't exist or has been moved.</p>

      <a
        href='/'
        class='bg-accent text-on-accent hover:bg-accent-hover mt-6 inline-block rounded-full px-6 py-3 text-[15px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)]'
      >
        Back to home
      </a>

      <div class='border-border bg-surface mt-8 rounded-2xl border p-4'>
        <p class='text-text-muted mb-2 text-sm'>Need support?</p>
        <a
          href='https://t.me/hipo_chat'
          target='_blank'
          rel='noreferrer'
          class='text-accent hover:text-accent-hover text-sm'
        >
          Hipo Chat
        </a>
      </div>
    </div>
  </body>
</html>

<style is:global>
  ::selection {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
