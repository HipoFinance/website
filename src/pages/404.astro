---
// The one site-wide 404 (GitHub Pages serves only /404.html, so there is no per-locale copy).
// Rendered in English; when the site has released non-English locales, a tiny inline script swaps
// lang/dir and the six strings if the first path segment is one of them (spec §H), so
// /fa/nonexistent/ reads in Persian. With no released locale the map is empty and the script a no-op.
import '../styles/global.css'
import { DEFAULT_LOCALE, releasedLocales } from '../i18n/registry.mjs'
import { dirOf, langOf } from '../i18n/locale.ts'
import { getT } from '../i18n/t.ts'

const STRINGS = ['title', 'heading', 'body', 'backHome', 'support', 'chat'] as const

const { t } = getT(DEFAULT_LOCALE, ['site'])

// { fa: { lang: 'fa', dir: 'rtl', strings: { title: '…', … } }, … } for the inline script.
const locales = Object.fromEntries(
  releasedLocales().map((locale) => {
    const { t } = getT(locale, ['site'])
    return [
      locale,
      {
        lang: langOf(locale),
        dir: dirOf(locale),
        strings: Object.fromEntries(STRINGS.map((key) => [key, t(`site.notFound.${key}`)])),
      },
    ]
  }),
)
---

<!doctype html>
<html lang={langOf(DEFAULT_LOCALE)} dir={dirOf(DEFAULT_LOCALE)} class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <title>{t('site.notFound.title')}</title>
    <meta name='robots' content='noindex' />
    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <body class='bg-bg font-body text-text flex min-h-screen items-center justify-center px-6'>
    <div class='w-full max-w-sm text-center'>
      <div class='font-fredoka text-accent text-6xl font-semibold'>404</div>

      <h1 class='font-fredoka text-text mt-4 text-xl font-semibold' data-i18n='heading'>
        {t('site.notFound.heading')}
      </h1>

      <p class='text-text-muted mt-2 text-[15px]' data-i18n='body'>{t('site.notFound.body')}</p>

      <a
        href='/'
        data-i18n='backHome'
        class='bg-accent text-on-accent hover:bg-accent-hover mt-6 inline-block rounded-full px-6 py-3 text-[15px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)]'
      >
        {t('site.notFound.backHome')}
      </a>

      <div class='border-border bg-surface mt-8 rounded-2xl border p-4'>
        <p class='text-text-muted mb-2 text-sm' data-i18n='support'>{t('site.notFound.support')}</p>
        <a
          href='https://t.me/hipo_chat'
          target='_blank'
          rel='noreferrer'
          class='text-accent hover:text-accent-hover text-sm'
          data-i18n='chat'
        >
          {t('site.notFound.chat')}
        </a>
      </div>
    </div>

    <script is:inline define:vars={{ locales }}>
      var key = location.pathname.split('/')[1]
      // Own keys only: `/constructor/x` would otherwise find Object.prototype.constructor.
      var info = Object.prototype.hasOwnProperty.call(locales, key) ? locales[key] : undefined
      if (info) {
        document.documentElement.lang = info.lang
        document.documentElement.dir = info.dir
        document.title = info.strings.title
        document.querySelectorAll('[data-i18n]').forEach(function (node) {
          node.textContent = info.strings[node.getAttribute('data-i18n')]
          if (node.getAttribute('href') === '/') node.setAttribute('href', '/' + key + '/')
        })
      }
    </script>
  </body>
</html>

<style is:global>
  ::selection {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
