---
import '../styles/global.css'
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Page not found | Hipo</title>
    <meta name='robots' content='noindex' />
    <link rel='icon' href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>

  <body class='bg-bg font-body text-text flex min-h-screen items-center justify-center px-6 py-16'>
    <div class='flex w-full max-w-[520px] flex-col items-center text-center'>
      <!-- Same glow-behind-artwork treatment as the home page hero, at a smaller size. -->
      <div class='relative flex justify-center'>
        <div
          class='absolute inset-[10%_4%] rounded-full'
          style='background: radial-gradient(closest-side, var(--hero-glow), rgba(255,126,115,0));'
        >
        </div>
        <img
          src='/images/hipo-bank.webp'
          alt=''
          class='relative w-[220px] max-w-full -rotate-6 drop-shadow-[0_20px_40px_var(--art-shadow)]'
        />
      </div>

      <div class='font-fredoka text-accent mt-2 text-[64px] leading-none font-semibold'>404</div>

      <h1 class='font-fredoka text-text mt-3 text-2xl font-semibold'>This page went for a swim</h1>

      <p class='text-text-muted mt-2.5 max-w-[380px] text-[15px] leading-[1.6]'>
        Our hippo can't find it. Everything else is still here, and your GRAM is still earning.
      </p>

      <div class='mt-7 flex flex-wrap items-center justify-center gap-3.5'>
        <a
          href='/'
          class='bg-accent-fill text-on-accent hover:bg-accent-fill-hover inline-block rounded-full px-7 py-3 text-[15px] font-semibold shadow-[0_6px_0_var(--color-accent-shadow)]'
        >
          Back to home
        </a>
        <a
          href='https://t.me/hipo_chat'
          target='_blank'
          rel='noreferrer'
          class='text-text hover:text-accent px-4 py-3 text-[15px] font-medium'
        >
          Ask on Hipo Chat →
        </a>
      </div>
    </div>
  </body>
</html>

<style is:global>
  ::selection {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
